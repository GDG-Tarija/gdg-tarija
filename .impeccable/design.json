  "components": [
    {
      "name": "Botón primario",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Acción principal: unirse a la comunidad.",
      "html": "<button class=\"ds-btn-primary\">Únete a la comunidad <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg></button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;gap:12px;white-space:nowrap;font-family:'Google Sans', system-ui, sans-serif;font-weight:600;font-size:1.125rem;padding:12px 28px;border:none;border-radius:9999px;cursor:pointer;box-shadow:0 1px 3px rgba(0,0,0,.1),0 1px 2px -1px rgba(0,0,0,.1);transition:background-color .2s,box-shadow .2s,translate .2s,scale .2s;background:#3367d6;color:#fff}.ds-btn-primary:hover{background:#2851b8}.ds-btn-primary:hover{translate:0 -2px;box-shadow:0 4px 6px -1px rgba(0,0,0,.1),0 2px 4px -2px rgba(0,0,0,.1)}.ds-btn-primary:active{translate:0 0;scale:.97}.ds-btn-primary:focus-visible{outline:none;box-shadow:0 0 0 2px #fff,0 0 0 4px #4285f4}"
    },
    {
      "name": "Botón outline",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "Secundario sobre fondos grises: \"Ver eventos\", \"Ver todos\".",
      "html": "<button class=\"ds-btn-outline\">Ver eventos</button>",
      "css": ".ds-btn-outline{display:inline-flex;align-items:center;justify-content:center;gap:12px;white-space:nowrap;font-family:'Google Sans', system-ui, sans-serif;font-weight:600;font-size:1.125rem;padding:12px 28px;border:none;border-radius:9999px;cursor:pointer;box-shadow:0 1px 3px rgba(0,0,0,.1),0 1px 2px -1px rgba(0,0,0,.1);transition:background-color .2s,box-shadow .2s,translate .2s,scale .2s;background:#fff;color:#1f2937;box-shadow:inset 0 0 0 1px #d1d5db,0 1px 3px rgba(0,0,0,.1)}.ds-btn-outline:hover{background:#f9fafb}.ds-btn-outline:hover{translate:0 -2px;box-shadow:0 4px 6px -1px rgba(0,0,0,.1),0 2px 4px -2px rgba(0,0,0,.1)}.ds-btn-outline:active{translate:0 0;scale:.97}.ds-btn-outline:focus-visible{outline:none;box-shadow:0 0 0 2px #fff,0 0 0 4px #4285f4}"
    },
    {
      "name": "Link con flecha",
      "kind": "custom",
      "refersTo": "button-primary",
      "description": "Acción secundaria de los encabezados de sección.",
      "html": "<a class=\"ds-arrow-link\" href=\"#\">Ver próximos eventos <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg></a>",
      "css": ".ds-arrow-link{display:inline-flex;align-items:center;gap:8px;font-family:'Google Sans', system-ui, sans-serif;font-weight:600;color:#3367d6;text-decoration:none;transition:color .2s}.ds-arrow-link svg{transition:transform .2s}.ds-arrow-link:hover{color:#3367d6}.ds-arrow-link:hover svg{transform:translateX(2px)}.ds-arrow-link:focus-visible{outline:2px solid #4285f4;outline-offset:4px;border-radius:2px}"
    },
    {
      "name": "Barra de navegación",
      "kind": "nav",
      "refersTo": "nav-bar",
      "description": "Barra flotante con enlaces y botón \"Únete\".",
      "html": "<nav class=\"ds-nav\"><strong class=\"ds-nav-logo\">GDG Tarija</strong><ul><li><a href=\"#\">Nosotros</a></li><li><a href=\"#\">Eventos</a></li><li><a href=\"#\">Equipo</a></li></ul><a class=\"ds-nav-cta\" href=\"#\">Únete</a></nav>",
      "css": ".ds-nav{display:flex;align-items:center;gap:32px;font-family:'Google Sans', system-ui, sans-serif;background:rgba(255,255,255,.85);backdrop-filter:blur(16px);border:1px solid #e5e7eb;border-radius:12px;padding:8px 32px;min-height:64px;box-shadow:0 1px 2px rgba(0,0,0,.05)}.ds-nav-logo{font-size:1.125rem;color:#1f2937;margin-right:auto}.ds-nav ul{display:flex;gap:32px;list-style:none;margin:0;padding:0}.ds-nav ul a{color:#374151;font-weight:500;text-decoration:none;transition:color .2s}.ds-nav ul a:hover{color:#111827}.ds-nav-cta{background:#4285f4;color:#fff;font-weight:600;font-size:.875rem;padding:8px 20px;border-radius:9999px;text-decoration:none}.ds-nav-cta:hover{background:#3367d6}"
    },
    {
      "name": "Chips de filtro",
      "kind": "chip",
      "refersTo": "chip-filter",
      "description": "Filtro del equipo por comisión; el seleccionado es tonal.",
      "html": "<div class=\"ds-filters\"><button class=\"ds-filter\" aria-pressed=\"true\">Todos <span>35</span></button><button class=\"ds-filter\" aria-pressed=\"false\"><i style=\"background:#4285f4\"></i>Organizer <span>4</span></button><button class=\"ds-filter\" aria-pressed=\"false\"><i style=\"background:#f9ab00\"></i>Marketing <span>18</span></button><button class=\"ds-filter\" aria-pressed=\"false\"><i style=\"background:#9334e6\"></i>Transmisión <span>3</span></button></div>",
      "css": ".ds-filters{display:flex;flex-wrap:wrap;gap:8px}.ds-filter{display:inline-flex;align-items:center;gap:8px;height:36px;padding:0 12px;border:1px solid #d1d5db;border-radius:8px;background:#fff;color:#374151;font-family:'Google Sans', system-ui, sans-serif;font-size:.875rem;font-weight:500;cursor:pointer;transition:background-color .2s}.ds-filter i{width:8px;height:8px;border-radius:9999px}.ds-filter span{color:#6b7280;font-variant-numeric:tabular-nums}.ds-filter:hover{background:#f9fafb}.ds-filter[aria-pressed=true]{background:#cae6ff;border-color:transparent;color:#111827}.ds-filter:focus-visible{outline:2px solid #4285f4;outline-offset:2px}"
    },
    {
      "name": "Card de miembro",
      "kind": "card",
      "refersTo": "card",
      "description": "Card vertical con foto grande, etiquetas de comisión y \"Ver perfil\".",
      "html": "<article class=\"ds-member\"><span class=\"ds-avatar\">PA</span><strong>Pedro Anze</strong><span class=\"ds-tag\"><i style=\"background:#4285f4\"></i>Organizer</span><button class=\"ds-member-open\">Ver perfil +</button></article>",
