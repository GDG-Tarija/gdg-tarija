---
import Button from 'components/common/Button.astro';
import ImageSlot from 'components/devfest2026/common/ImageSlot.astro';
import { DEVFEST_ASSETS } from 'components/devfest2026/assets';
import { EVENT } from 'components/devfest2026/data';

// Enlaces comentados: se descomentan junto con su sección en devfest-2026.astro
const links = [
  { href: '#devfest', label: 'DevFest' },
  // { href: '#pasaporte', label: 'Pasaporte' },
  // { href: '#agenda', label: 'Agenda' },
  // { href: '#speakers', label: 'Speakers' },
  // { href: '#faq', label: 'FAQ' },
];
---

<header
  id="df-header"
  class="df-header fixed inset-x-0 top-0 z-40 border-b border-transparent bg-transparent transition-[background-color,border-color] duration-200 data-[scrolled=true]:border-df-hairline data-[scrolled=true]:bg-df-surface/95 data-[scrolled=true]:backdrop-blur-md"
>
  <div class="mx-auto max-w-df px-df-gutter-mobile md:px-df-gutter">
    <div class="flex h-16 items-center justify-between gap-df-base">
      <a
        href="#inicio"
        aria-label="DevFest Tarija 2026, ir al inicio"
        class="w-36 shrink-0 rounded-df-control focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gdg-blue-deep"
      >
        <ImageSlot
          label="Logo DevFest Tarija"
          ratio="4 / 1"
          src={DEVFEST_ASSETS.logo}
          loading="eager"
          fit="contain"
          class="min-h-9 text-xs"
        />
      </a>

      <nav
        aria-label="Navegación principal"
        class="hidden items-center gap-df-lg md:mx-auto md:flex"
      >
        {
          links.map(({ href, label }) => (
            <a
              href={href}
              class="text-df-body text-df-ink-body transition-colors hover:text-gdg-blue-deep focus-visible:rounded-df-tag focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gdg-blue-deep"
            >
              {label}
            </a>
          ))
        }
      </nav>

      <Button href={EVENT.registerUrl} size="sm" iconPosition="right">
        Inscribite
        <i slot="icon" class="fa-solid fa-arrow-right" aria-hidden="true"></i>
      </Button>
    </div>

    <nav
      aria-label="Secciones de DevFest"
      class="grid auto-cols-fr grid-flow-col gap-df-xs md:hidden"
    >
      {
        links.map(({ href, label }) => (
          <a
            href={href}
            class="flex min-h-11 items-center justify-center whitespace-nowrap text-df-body text-df-ink transition-colors hover:text-gdg-blue-deep focus-visible:rounded-df-tag focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gdg-blue-deep"
          >
            {label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById('df-header');
  const updateScrolled = () => header?.setAttribute('data-scrolled', String(window.scrollY > 12));

  updateScrolled();
  window.addEventListener('scroll', updateScrolled, { passive: true });
</script>
