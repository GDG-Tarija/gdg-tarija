---
import Button from 'components/common/Button.astro';
import SectionShell from 'components/devfest2026/common/SectionShell.astro';
import SectionHeading from 'components/devfest2026/common/SectionHeading.astro';
import { EVENT } from 'components/devfest2026/data';

const included = [
  'Entrada al evento',
  'Credencial',
  'Refrigerio',
  'Almuerzo',
  'Todas las actividades, Hack Racing incluido',
];
---

{
  /* Sigue el celeste de la sección anterior y el amarillo va en un panel: sin corte brusco entre los dos */
}
<SectionShell
  id="inscripcion"
  label="Qué incluye tu entrada"
  tone="ice"
  class="[&>div]:pt-0 md:[&>div]:pt-0"
>
  <div
    class="df-tone-pastel grid items-center bg-gdg-pastel-yellow gap-df-lg rounded-df-panel p-df-lg sm:p-df-section lg:grid-cols-2 lg:gap-df-section"
  >
    <div>
      <SectionHeading
        id="inscripcion-titulo"
        eyebrow="Inscripción"
        title="Qué incluye tu entrada"
        lead={`Un solo pago te da acceso a toda la jornada del sábado 28 en la ${EVENT.venueShort}. Hay ${EVENT.capacity} cupos.`}
      />
      <p class="m-0 flex flex-wrap items-baseline gap-df-md">
        <span class="text-df-stat text-df-ink-strong">{EVENT.price}</span>
        <s class="text-df-lead text-df-ink-muted"
          ><span class="sr-only">antes </span>{EVENT.regularPrice}</s
        >
      </p>
      <div class="mt-df-lg">
        <Button href={EVENT.registerUrl} iconPosition="right">
          Inscríbete por {EVENT.price}
          <i slot="icon" class="fa-solid fa-arrow-right" aria-hidden="true"></i>
        </Button>
      </div>
    </div>

    <ul
      class="m-0 list-none rounded-df-panel border border-df-hairline bg-df-ground px-df-lg py-df-sm"
    >
      {
        included.map((item) => (
          <li class="flex items-center gap-df-md border-b border-df-hairline py-df-md text-df-body text-df-ink last:border-b-0">
            <i class="fa-solid fa-check text-df-green-deep" aria-hidden="true" />
            {item}
          </li>
        ))
      }
    </ul>
  </div>
</SectionShell>
