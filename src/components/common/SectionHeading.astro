---
interface Props {
  id: string;
  title: string;
  lead?: string;
}

const { id, title, lead } = Astro.props;
const hasAction = Astro.slots.has('action');
---

<div
  data-reveal
  class="mb-8 flex flex-col gap-4 md:mb-10 md:flex-row md:items-end md:justify-between"
>
  <div class="max-w-2xl">
    <h2
      id={id}
      class="text-[1.75rem] leading-tight font-medium tracking-[-0.01em] text-balance text-gray-900 md:text-4xl"
    >
      {title}
    </h2>
    {
      lead && (
        <p class="mt-3 text-base leading-relaxed text-pretty text-gray-600 md:text-lg">{lead}</p>
      )
    }
  </div>
  {
    hasAction && (
      <div class="shrink-0">
        <slot name="action" />
      </div>
    )
  }
</div>
