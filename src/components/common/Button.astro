---
interface Props {
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  variant?: 'primary' | 'secondary' | 'outline' | 'inverse';
  size?: 'sm' | 'md' | 'lg';
  iconPosition?: 'left' | 'right';
  class?: string;
  target?: string;
  rel?: string;
  onclick?: string;
  id?: string;
}

const {
  href,
  type = 'button',
  variant = 'primary',
  size = 'md',
  iconPosition = 'left',
  class: className = '',
  target,
  rel,
  onclick,
  id,
} = Astro.props;

// Como en los botones de Google: la respuesta es un cambio de tono, no un movimiento (DESIGN.md, Buttons)
const baseClasses =
  'inline-flex cursor-pointer items-center justify-center gap-2 whitespace-nowrap font-medium rounded-lg transition-colors duration-150 ease-out focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-gdg-blue';

const variantClasses = {
  primary: 'bg-gdg-blue-deep hover:bg-gdg-blue-press text-white shadow-xs',
  secondary: 'bg-gray-200 hover:bg-gray-300 text-gray-800',
  // Para fondos grises claros, donde el secundario gris se pierde contra el fondo
  outline: 'bg-white hover:bg-gdg-ice-blue/40 text-gdg-blue-deep ring-1 ring-inset ring-gray-300',
  // Para bloques de color (el CTA azul): el botón blanco mantiene el contraste que el azul sobre azul perdería
  inverse:
    'bg-white hover:bg-gdg-ice-blue text-gdg-blue-deep focus-visible:ring-white focus-visible:ring-offset-gdg-blue-deep',
};

const sizeClasses = {
  sm: 'h-9 px-4 text-sm',
  md: 'h-10 px-5 text-sm',
  lg: 'h-12 px-6 text-base',
};

const buttonClasses = `${baseClasses} ${variantClasses[variant]} ${sizeClasses[size]} ${className}`;
// Evita renderizar un contenedor vacío con margen cuando no se pasa icono
const hasIcon = Astro.slots.has('icon');
---

{
  href ? (
    <a href={href} class={buttonClasses} target={target} rel={rel} id={id}>
      {hasIcon && iconPosition === 'left' && (
        <span class="flex">
          <slot name="icon" />
        </span>
      )}
      <slot />
      {hasIcon && iconPosition === 'right' && (
        <span class="flex">
          <slot name="icon" />
        </span>
      )}
    </a>
  ) : (
    <button type={type} class={buttonClasses} onclick={onclick} id={id}>
      {hasIcon && iconPosition === 'left' && (
        <span class="flex">
          <slot name="icon" />
        </span>
      )}
      <slot />
      {hasIcon && iconPosition === 'right' && (
        <span class="flex">
          <slot name="icon" />
        </span>
      )}
    </button>
  )
}
