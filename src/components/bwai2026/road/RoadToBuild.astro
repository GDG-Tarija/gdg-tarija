---
import { Image } from 'astro:assets'
import milestones from './milestones.json'
import speakersRaw from '../speakers-road/speakers-road.json'

const milestoneHasSpeakers = new Set(
  (speakersRaw as Array<{ milestoneId?: string }>)
    .filter(s => s.milestoneId)
    .map(s => s.milestoneId!)
)
---

<section
  id="road-to-build"
  class="bg-bwai-background py-16 md:py-20 overflow-hidden border-t border-gray-800"
  aria-labelledby="rtb-heading"
>
  <div class="max-w-5xl mx-auto px-4 md:px-8">

    <header class="text-center mb-10 md:mb-14">
      <p class="text-xs font-semibold tracking-[0.28em] uppercase text-gdg-blue mb-3">
        Tu Camino
      </p>
      <h2
        id="rtb-heading"
        class="text-3xl md:text-4xl lg:text-5xl font-bold text-white leading-tight"
      >
        Road to <span class="text-gdg-blue">Build</span> with AI
      </h2>
      <p class="mt-4 text-white/50 mx-auto text-sm leading-relaxed">
        Tres eventos, un camino. De los fundamentos a construir con IA en vivo.
      </p>
    </header>

    <!-- ── DESKTOP ──────────────── -->
    <div class="hidden md:block">

      <!-- Stepper -->
      <div class="flex items-center justify-between px-16 mb-6">
        {milestones.map((m, i) => (
          <Fragment>
            <div
              class="flex flex-col items-center relative"
              data-milestone-node
              data-iso={m.isoDate}
              data-color={m.color}
            >
              <div class="absolute w-5 h-5 rounded-full rtb-pulse-ring" data-pulse-ring aria-hidden="true"></div>
              <div class="w-5 h-5 rounded-full z-10 rtb-dot" data-dot aria-hidden="true"></div>
              <span class="mt-2.5 font-bold text-white/25 uppercase rtb-step-label" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
            </div>

            {i < milestones.length - 1 && (
              <div class="flex-1 mx-8" aria-hidden="true">
                <svg viewBox="0 0 200 6" class="w-full" height="6" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
                  <line x1="0" y1="3" x2="200" y2="3" class="rtb-track" stroke-width="1.5" stroke-dasharray="5 5" />
                  <line x1="0" y1="3" x2="200" y2="3" class="rtb-segment" stroke-width="2" stroke-linecap="round" data-segment data-segment-index={String(i)} data-color={m.color} />
                </svg>
              </div>
            )}
          </Fragment>
        ))}
      </div>

      <!-- Cards con tab trigger -->
      <div
        role="tablist"
        aria-label="Selecciona un evento para ver sus speakers"
        class="grid grid-cols-3 gap-5"
      >
        {milestones.map((m) => (
          <article
            class={`rtb-card rtb-card-${m.color} rtb-card-main group rounded-2xl border p-5 flex flex-col gap-3 transition-transform duration-300 hover:-translate-y-1 cursor-pointer`}
            data-milestone-card
            data-iso={m.isoDate}
            data-color={m.color}
            data-milestone-id={m.isoDate}
          >
            <div
              class={`rtb-img rtb-img-${m.color} w-full p-4 rounded-xl flex items-center justify-center mb-1`}
              aria-hidden="true"
            >
              <Image src={m.imgSrc} alt={m.title} width={624} height={624} decoding="async" class="w-auto rounded-md" />
            </div>

            <div class="flex flex-wrap gap-2">
              <span class={`rtb-tag rtb-tag-${m.color} text-xs font-medium px-2.5 py-0.5 rounded-full border`}>
                {m.tag}
              </span>
            </div>

            <time class={`rtb-date-${m.color} text-sm font-semibold tracking-wide block`} datetime={m.isoDate}>
              {m.dateLabel}
            </time>

            <div>
              <h3 class="text-white font-bold text-base leading-snug">{m.title}</h3>
              <p class="text-white/45 text-sm mt-1 leading-relaxed">{m.subtitle}</p>
            </div>

            <a
              href={m.ctaHref}
              target="_blank"
              class={`rtb-btn rtb-btn-${m.color} mt-auto inline-flex items-center justify-center gap-2 px-4 py-2 rounded-lg border text-sm font-medium transition-all duration-200`}
              aria-label={`${m.ctaText}: ${m.title}`}
            >
              {m.ctaText}
              <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:translate-x-0.5" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M2.917 7H11.083M7.583 3.5L11.083 7l-3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
            {milestoneHasSpeakers.has(m.isoDate) ? (
              <a
                id={`tab-trigger-${m.isoDate}`}
                href="#speakers-road"
                class={`rtb-speakers-btn rtb-speakers-btn-${m.color} w-full flex items-center cursor-pointer justify-center gap-1.5 py-1.5 text-xs rounded-lg border transition-colors duration-200`}
                data-tab-trigger
                data-milestone-id={m.isoDate}
                aria-expanded="false"
                aria-controls={`speakers-panel-${m.isoDate}`}
                type="button"
              >
                <span class="rtb-speakers-btn-label">Ver speakers</span>
                <svg class="w-3 h-3 rtb-speakers-btn-icon transition-transform duration-200" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                  <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            ) : (
              <a
                id={`tab-trigger-${m.isoDate}`}
                href="#speakers-road"
                class="rtb-speakers-btn rtb-speakers-btn-muted w-full flex items-center justify-center gap-1.5 py-1.5 text-xs cursor-pointer rounded-lg border transition-colors duration-200"
                data-tab-trigger
                data-coming-soon
                data-milestone-id={m.isoDate}
                aria-expanded="false"
                aria-controls={`speakers-panel-${m.isoDate}`}
                type="button"
              >
                <svg class="w-3 h-3 shrink-0" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                  <circle cx="6" cy="6" r="4.5" stroke="currentColor" stroke-width="1.2"/>
                  <path d="M6 3.5v2.5l1.5 1" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span>Próximamente</span>
              </a>
            )}
          </article>
        ))}
      </div>
    </div>

    <!-- ── MOBILE ────────────────────────── -->
    <ol class="md:hidden" aria-label="Hitos del camino al evento">
      {milestones.map((m, i) => (
        <li
          class="flex p-2 gap-4 justify-center"
          data-milestone-node
          data-iso={m.isoDate}
          data-color={m.color}
        >
          <div class="flex flex-col items-center shrink-0 pt-1">
            <div class="absolute w-5 h-5 -mt-1 rounded-full rtb-pulse-ring" data-pulse-ring aria-hidden="true"></div>
            <div class="w-3.5 h-3.5 rounded-full z-10 shrink-0 rtb-dot" data-dot aria-hidden="true"></div>
            {i < milestones.length - 1 && (
              <div class="w-px flex-1 mt-2 rtb-mobile-line" data-connector data-color={m.color} aria-hidden="true"></div>
            )}
          </div>

          <article
            class={`rtb-card max-w-65 rtb-card-${m.color} rtb-card-main flex-1 rounded-2xl border p-4 flex flex-col gap-3 mb-5 cursor-pointer`}
            data-milestone-card
            data-iso={m.isoDate}
            data-color={m.color}
            data-milestone-id={m.isoDate}
          >
            <div class={`rtb-img rtb-img-${m.color} p-4 rounded-xl flex items-center justify-center`} aria-hidden="true">
              <Image src={m.imgSrc} alt={m.title} width={200} height={200} decoding="async" class="w-auto h-40 rounded-md" />
            </div>

            <div class="flex flex-wrap">
              <span class={`rtb-tag rtb-tag-${m.color} text-xs font-medium px-2.5 py-0.5 rounded-full border inline-block`}>
                {m.tag}
              </span>
            </div>

            <time class={`rtb-date-${m.color} text-xs font-semibold tracking-wide`} datetime={m.isoDate}>
              {m.dateLabel}
            </time>

            <div>
              <h3 class="text-white font-bold text-sm leading-snug">{m.title}</h3>
              <p class="text-white/45 text-xs mt-1 leading-relaxed">{m.subtitle}</p>
            </div>

            <a
              href={m.ctaHref}
              class={`rtb-btn rtb-btn-${m.color} w-full inline-flex items-center justify-center gap-1.5 px-3.5 py-1.5 rounded-lg border text-xs font-medium transition-all duration-200`}
              target="_blank"
            >
              {m.ctaText}
              <svg class="w-3 h-3" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M2.917 7H11.083M7.583 3.5L11.083 7l-3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>

            {milestoneHasSpeakers.has(m.isoDate) ? (
              <a
                id={`tab-trigger-mob-${m.isoDate}`}
                href="#speakers-road"
                class={`rtb-speakers-btn rtb-speakers-btn-${m.color} w-full flex items-center justify-center gap-1.5 py-1.5 text-xs rounded-lg border transition-colors duration-200`}
                data-tab-trigger
                data-milestone-id={m.isoDate}
                aria-expanded="false"
                aria-controls={`speakers-panel-${m.isoDate}`}
                type="button"
              >
                <span class="rtb-speakers-btn-label">Ver speakers</span>
                <svg class="w-3 h-3 rtb-speakers-btn-icon transition-transform duration-200" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                  <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            ) : (
              <a
                id={`tab-trigger-mob-${m.isoDate}`}
                href="#speakers-road"
                class="rtb-speakers-btn rtb-speakers-btn-muted w-full flex items-center justify-center gap-1.5 py-1.5 text-xs rounded-lg border transition-colors duration-200"
                data-tab-trigger
                data-coming-soon
                data-milestone-id={m.isoDate}
                aria-expanded="false"
                aria-controls={`speakers-panel-${m.isoDate}`}
                type="button"
              >
                <svg class="w-3 h-3 shrink-0" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                  <circle cx="6" cy="6" r="4.5" stroke="currentColor" stroke-width="1.2"/>
                  <path d="M6 3.5v2.5l1.5 1" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span>Próximamente</span>
              </a>
            )}
          </article>
        </li>
      ))}
    </ol>

  </div>
</section>

<style>
  /* ── Stepper ─────────────────────────────── */
  .rtb-step-label { font-size: 12px; letter-spacing: .1em; }

  .rtb-track   { stroke: rgba(255,255,255,.1); }
  .rtb-segment { stroke: transparent; transition: stroke .7s ease; }

  [data-segment][data-active="true"][data-color="blue"]   { stroke: var(--color-gdg-blue); }
  [data-segment][data-active="true"][data-color="green"]  { stroke: var(--color-gdg-green); }
  [data-segment][data-active="true"][data-color="yellow"] { stroke: var(--color-gdg-yellow); }

  /* ── Dot ─────────────────────────────────── */
  .rtb-dot {
    background: rgba(255,255,255,.12);
    border: 2px solid rgba(255,255,255,.18);
    transition: transform .35s ease, box-shadow .35s ease;
  }

  [data-milestone-node][data-color="blue"]   .rtb-dot { background: var(--color-gdg-blue);   border-color: var(--color-gdg-blue); }
  [data-milestone-node][data-color="green"]  .rtb-dot { background: var(--color-gdg-green);  border-color: var(--color-gdg-green); }
  [data-milestone-node][data-color="yellow"] .rtb-dot { background: var(--color-gdg-yellow); border-color: var(--color-gdg-yellow); }

  [data-milestone-node][data-state="active"][data-color="blue"]   .rtb-dot { transform: scale(1.45); box-shadow: 0 0 10px 2px rgba(66,133,244,.6); }
  [data-milestone-node][data-state="active"][data-color="green"]  .rtb-dot { transform: scale(1.45); box-shadow: 0 0 10px 2px rgba(52,168,83,.6); }
  [data-milestone-node][data-state="active"][data-color="yellow"] .rtb-dot { transform: scale(1.45); box-shadow: 0 0 10px 2px rgba(249,171,0,.6); }
  [data-milestone-node][data-state="past"]   .rtb-dot { opacity: .35; }

  /* ── Pulse ring ──────────────────────────── */
  .rtb-pulse-ring { opacity: 0; transform: scale(1); transform-origin: center; }

  [data-milestone-node][data-color="blue"]   .rtb-pulse-ring { background: var(--color-gdg-blue); }
  [data-milestone-node][data-color="green"]  .rtb-pulse-ring { background: var(--color-gdg-green); }
  [data-milestone-node][data-color="yellow"] .rtb-pulse-ring { background: var(--color-gdg-yellow); }

  @keyframes rtb-ping {
    0%   { transform: scale(1);   opacity: .5; }
    100% { transform: scale(3.2); opacity: 0; }
  }

  [data-milestone-node][data-state="active"] .rtb-pulse-ring { animation: rtb-ping 2.2s ease-out infinite; }

  /* ── Cards ───────────────────────────────── */
  .rtb-card { background: var(--color-bwai-border); }

  .rtb-card-blue   { border-color: rgba(66,133,244,.2); }
  .rtb-card-green  { border-color: rgba(52,168,83,.2); }
  .rtb-card-yellow { border-color: rgba(249,171,0,.2); }

  [data-milestone-card][data-state="active"].rtb-card-blue,
  [data-milestone-card][data-tab-selected="true"].rtb-card-blue   { border-color: rgba(66,133,244,.65); box-shadow: 0 6px 36px -8px rgba(66,133,244,.22); }
  [data-milestone-card][data-state="active"].rtb-card-green,
  [data-milestone-card][data-tab-selected="true"].rtb-card-green  { border-color: rgba(52,168,83,.65);  box-shadow: 0 6px 36px -8px rgba(52,168,83,.22); }
  [data-milestone-card][data-state="active"].rtb-card-yellow,
  [data-milestone-card][data-tab-selected="true"].rtb-card-yellow { border-color: rgba(249,171,0,.65);  box-shadow: 0 6px 36px -8px rgba(249,171,0,.22); }

  [data-milestone-card][data-state="past"] { opacity: .5; }

  .rtb-card-main { outline: 1px solid rgba(249,171,0,.07); outline-offset: 2px; }

  /* ── Image wrappers ──────────────────────── */
  .rtb-img-blue   { background: rgba(66,133,244,.07); border: 1px solid rgba(66,133,244,.14); }
  .rtb-img-green  { background: rgba(52,168,83,.07);  border: 1px solid rgba(52,168,83,.14); }
  .rtb-img-yellow { background: rgba(249,171,0,.07);  border: 1px solid rgba(249,171,0,.14); }

  /* ── Tags ────────────────────────────────── */
  .rtb-tag-blue   { background: rgba(66,133,244,.1);  color: var(--color-gdg-blue);   border-color: rgba(66,133,244,.25); }
  .rtb-tag-green  { background: rgba(52,168,83,.1);   color: var(--color-gdg-green);  border-color: rgba(52,168,83,.25); }
  .rtb-tag-yellow { background: rgba(249,171,0,.1);   color: var(--color-gdg-yellow); border-color: rgba(249,171,0,.25); }

  /* ── Dates ───────────────────────────────── */
  .rtb-date-blue   { color: rgba(66,133,244,.65); }
  .rtb-date-green  { color: rgba(52,168,83,.65); }
  .rtb-date-yellow { color: rgba(249,171,0,.65); }

  /* ── CTA buttons ─────────────────────────── */
  .rtb-btn-blue   { color: var(--color-gdg-blue);   border-color: rgba(66,133,244,.4); }
  .rtb-btn-green  { color: var(--color-gdg-green);  border-color: rgba(52,168,83,.4); }
  .rtb-btn-yellow { color: var(--color-gdg-yellow); border-color: rgba(249,171,0,.4); }

  .rtb-btn-blue:hover   { background: var(--color-gdg-blue);   color: var(--color-gdg-black); border-color: var(--color-gdg-blue); }
  .rtb-btn-green:hover  { background: var(--color-gdg-green);  color: var(--color-gdg-black); border-color: var(--color-gdg-green); }
  .rtb-btn-yellow:hover { background: var(--color-gdg-yellow); color: var(--color-gdg-black); border-color: var(--color-gdg-yellow); }

  /* ── "Ver speakers" tab trigger button ───── */
  .rtb-speakers-btn { background: transparent; }

  .rtb-speakers-btn-blue   { color: rgba(66,133,244,.6); border-color: rgba(66,133,244,.3); }
  .rtb-speakers-btn-green  { color: rgba(52,168,83,.6);  border-color: rgba(52,168,83,.3); }
  .rtb-speakers-btn-yellow { color: rgba(249,171,0,.6);  border-color: rgba(249,171,0,.3); }

  .rtb-speakers-btn-blue:hover,
  [data-milestone-card][data-tab-selected="true"][data-color="blue"] .rtb-speakers-btn-blue     { color: rgba(66,133,244,.9); border-color: rgba(66,133,244,.4); }
  .rtb-speakers-btn-green:hover,
  [data-milestone-card][data-tab-selected="true"][data-color="green"] .rtb-speakers-btn-green   { color: rgba(52,168,83,.9);  border-color: rgba(52,168,83,.4); }
  .rtb-speakers-btn-yellow:hover,
  [data-milestone-card][data-tab-selected="true"][data-color="yellow"] .rtb-speakers-btn-yellow { color: rgba(249,171,0,.9);  border-color: rgba(249,171,0,.4); }

  /* Botón "Próximamente" — borde punteado, colores atenuados */
  .rtb-speakers-btn-muted { color: rgba(255,255,255,.5); border-color: rgba(255,255,255,.3); border-style: dashed; }
  .rtb-speakers-btn-muted:hover { color: rgba(255,255,255,.6); border-color: rgba(255,255,255,.4); }
  /* Coming-soon no reacciona al estado selected */
  [data-milestone-card][data-tab-selected="true"] .rtb-speakers-btn-muted { color: rgba(255,255,255,.4); border-color: rgba(255,255,255,.3); }

  [data-tab-trigger][aria-expanded="true"] .rtb-speakers-btn-icon { transform: rotate(180deg); }

  /* ── Mobile connector line ───────────────── */
  .rtb-mobile-line { border-left: 1.5px dashed rgba(255,255,255,.1); transition: border-color .6s ease; }

  [data-connector][data-active="true"][data-color="blue"]   { border-color: rgba(66,133,244,.45); }
  [data-connector][data-active="true"][data-color="green"]  { border-color: rgba(52,168,83,.45); }
  [data-connector][data-active="true"][data-color="yellow"] { border-color: rgba(249,171,0,.45); }
</style>

<script>
  // ── Helpers ────────────────────────────────────────────────────────
  function buildStateMap(nodes: HTMLElement[]): Map<string, 'past' | 'active' | 'future'> {
    const today = new Date();
    today.setHours(0, 0, 0, 0);

    const seen = new Set<string>();
    const orderedIsos: string[] = [];
    nodes.forEach(n => { const iso = n.dataset.iso ?? ''; if (iso && !seen.has(iso)) { seen.add(iso); orderedIsos.push(iso); } });

    const map = new Map<string, 'past' | 'active' | 'future'>();
    let found = false;
    orderedIsos.forEach(iso => {
      const d = new Date(iso + 'T00:00:00');
      const state: 'past' | 'active' | 'future' = d < today ? 'past' : found ? 'future' : (found = true, 'active');
      map.set(iso, state);
    });
    return map;
  }

  function setSelected(id: string): void {
    document.querySelectorAll<HTMLElement>('[data-milestone-card]').forEach(c => {
      c.dataset.tabSelected = String(c.dataset.milestoneId === id);
    });
    document.querySelectorAll<HTMLButtonElement>('[data-tab-trigger]').forEach(btn => {
      const isSelected = btn.dataset.milestoneId === id;
      btn.setAttribute('aria-expanded', String(isSelected));
      // Los botones "próximamente" mantienen su label estático
      if (btn.hasAttribute('data-coming-soon')) return;
      const label = btn.querySelector('.rtb-speakers-btn-label');
      if (label) label.textContent = isSelected ? 'Ver speakers' : 'Ver speakers';
    });
  }

  function selectMilestone(id: string): void {
    setSelected(id);
    document.dispatchEvent(new CustomEvent('rtb:milestone-select', { detail: { id } }));
  }

  // ── Init ────────────────────────────────────────────────────────────
  function initRTB(): void {
    const section = document.getElementById('road-to-build');
    if (!section) return;

    const allNodes = Array.from(section.querySelectorAll<HTMLElement>('[data-milestone-node]'));
    const stateMap = buildStateMap(allNodes);
    const orderedIsos = [...new Set(allNodes.map(n => n.dataset.iso).filter(Boolean))] as string[];

    // Aplicar estados
    allNodes.forEach(n => { const s = stateMap.get(n.dataset.iso ?? ''); if (s) n.dataset.state = s; });
    section.querySelectorAll<HTMLElement>('[data-milestone-card]').forEach(c => {
      const s = stateMap.get(c.dataset.iso ?? ''); if (s) c.dataset.state = s;
    });

    // Segmentos SVG
    section.querySelectorAll<SVGLineElement>('[data-segment]').forEach(seg => {
      const targetIso = orderedIsos[parseInt(seg.dataset.segmentIndex ?? '0', 10) + 1];
      const ts = stateMap.get(targetIso);
      if (ts === 'past' || ts === 'active') seg.dataset.active = 'true';
    });

    // Conectores mobile
    section.querySelectorAll<HTMLElement>('[data-connector]').forEach((conn, i) => {
      if (stateMap.get(orderedIsos[i]) === 'past') conn.dataset.active = 'true';
    });

    // Selección inicial: primero el milestone activo/próximo; si todos pasaron, el más reciente
    // (garantiza que el evento con speakers actuales sea el visible por defecto)
    const initialIso =
      orderedIsos.find(iso => stateMap.get(iso) === 'active') ??
      orderedIsos.find(iso => stateMap.get(iso) === 'future')  ??
      orderedIsos[orderedIsos.length - 1];
    if (initialIso) setSelected(initialIso);

    // ── Delegación de eventos en la sección ─────────────────────────
    // (elemento nuevo en cada navegación → no acumula listeners)
    section.addEventListener('click', (e: MouseEvent) => {
      // Botón explícito: click en [data-tab-trigger]
      const trigger = (e.target as Element).closest<HTMLElement>('[data-tab-trigger]');
      if (trigger?.dataset.milestoneId) { selectMilestone(trigger.dataset.milestoneId); return; }

      // Click en la card (excepto sobre el link CTA)
      const card = (e.target as Element).closest<HTMLElement>('[data-milestone-card]');
      if (card?.dataset.milestoneId && !(e.target as Element).closest('a')) {
        selectMilestone(card.dataset.milestoneId);
      }
    });
  }

  document.addEventListener('DOMContentLoaded', initRTB);
  document.addEventListener('astro:page-load', initRTB);
</script>
