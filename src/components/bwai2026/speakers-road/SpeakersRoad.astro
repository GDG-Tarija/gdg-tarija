---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import milestones from '../road/milestones.json'
import speakersJson from './speakers-road.json';
import SocialNetworksBwai2026 from './SocialNetworksBwai2026.astro';


// Agrupa los speakers por milestoneId (= isoDate del milestone)
const speakersByMilestone = Object.fromEntries(
  milestones.map(m => [m.isoDate, speakersJson.filter(s => s.milestoneId === m.isoDate)])
);
---

<section
  id="speakers-road"
  aria-labelledby="speakers-road-title"
  class="relative bg-bwai-background px-4 py-12 md:py-20 overflow-hidden border-t border-gray-800"
>
  <div class="relative max-w-7xl mx-auto px-6 xl:px-14">

    <!-- Panels: uno por milestone, oculto por defecto -->
    <div class="relative">
      {milestones.map((milestone) => {
        const panelSpeakers = speakersByMilestone[milestone.isoDate] ?? [];
        // Grid adaptado: 4 speakers → 2×2 en md / 4 en xl | 3 speakers → 3 en md
        const gridClass = panelSpeakers.length >= 4
          ? 'grid-cols-1 sm:grid-cols-2 xl:grid-cols-4'
          : 'grid-cols-1 md:grid-cols-3';

        return (
          <div
            id={`speakers-panel-${milestone.isoDate}`}
            role="tabpanel"
            aria-labelledby={`tab-trigger-${milestone.isoDate}`}
            data-speakers-panel
            data-milestone-id={milestone.isoDate}
            data-milestone-color={milestone.color}
            hidden
          >
            <header class="mb-6 md:mb-9">
              <p class={`text-gdg-${milestone.color} font-medium text-sm sm:text-base
                        tracking-wider mb-2`}>
                {milestone.title}
              </p>
              <h2
                id="speakers-road-title"
                class="text-2xl md:text-3xl font-bold text-gdg-off-white mb-3 leading-tight"
              >
                Speakers Road to Build
              </h2>
            </header>
            <p
              class={`text-gdg-${milestone.color} font-medium text-sm tracking-wider mb-6`}
              data-animate
              data-stagger="0"
            >
              {milestone.tag} · {milestone.dateLabel}
            </p>
            {panelSpeakers.length === 0 ? (
              <!-- Placeholder "Próximamente" -->
              <div
                class="spk-placeholder"
                data-animate
                data-stagger="1"
                role="status"
                aria-label={`Speakers de ${milestone.title} — anuncio próximamente`}
              >
                <!-- Ghost speaker cards (decorativo) -->
                <div class="spk-ghost-wrap" aria-hidden="true">
                  <div class="spk-ghost spk-ghost-side">
                    <div class="spk-skel-photo"></div>
                    <div class="spk-skel-body">
                      <div class="spk-skel-line"></div>
                      <div class="spk-skel-line spk-skel-line-short"></div>
                      <div class="spk-skel-line spk-skel-line-long"></div>
                    </div>
                  </div>
                  <div class="spk-ghost spk-ghost-center">
                    <div class="spk-skel-photo"></div>
                    <div class="spk-skel-body">
                      <div class="spk-skel-line"></div>
                      <div class="spk-skel-line spk-skel-line-short"></div>
                      <div class="spk-skel-line spk-skel-line-long"></div>
                      <div class="spk-skel-line spk-skel-line-mid"></div>
                    </div>
                  </div>
                  <div class="spk-ghost spk-ghost-side">
                    <div class="spk-skel-photo"></div>
                    <div class="spk-skel-body">
                      <div class="spk-skel-line"></div>
                      <div class="spk-skel-line spk-skel-line-short"></div>
                      <div class="spk-skel-line spk-skel-line-long"></div>
                    </div>
                  </div>
                </div>
                <!-- Badge -->
                <div class="spk-badge" aria-hidden="true">
                  <span class="spk-badge-dot"></span>
                  <span>Próximamente</span>
                </div>
                <p class="spk-badge-date">{milestone.dateLabel}</p>
              </div>
            ) : (
              <div class={`grid gap-5 justify-items-center ${gridClass}`}>
                {panelSpeakers.map((speaker, index) => (
                <div
                  class="flex flex-col gap-3 max-w-sm w-full"
                  data-animate
                  data-stagger={index + 1}
                >
                  <article
                    class="speaker-card group w-full flex flex-col"
                    aria-label={`Speaker: ${speaker.name}`}
                  >
                    <div class={`rounded-2xl p-px flex flex-col h-full border speaker-card-${milestone.color}`}>
                      <div class="rounded-[15px] bg-bwai-background overflow-hidden flex flex-col h-full">

                        <!-- Foto -->
                        <div class="relative overflow-hidden h-70 shrink-0">
                          <span
                            class="absolute bottom-3 right-3 flex items-center gap-1.5 bg-bwai-background/80 text-gdg-off-white text-[10px] font-medium px-2.5 py-1 rounded-full"
                            aria-label={`Speaker de ${speaker.location.city}, ${speaker.location.country}`}
                          >
                            <span aria-hidden="true">{speaker.location.flag}</span>
                            {speaker.location.city}, {speaker.location.country}
                          </span>
                          <Image
                            src={speaker.photo}
                            alt={`Foto de ${speaker.name}`}
                            width={400}
                            height={280}
                            class="w-full h-full object-cover object-top"
                          />
                          <div
                            class="absolute inset-0 bg-linear-to-t from-bwai-background/50 via-transparent to-transparent pointer-events-none"
                            aria-hidden="true"
                          />
                        </div>

                        <!-- Info -->
                        <div class="flex flex-col flex-1 p-5 gap-2">
                          <h3 class="text-gdg-off-white font-semibold text-base leading-snug">
                            {speaker.name}
                          </h3>

                          {speaker.socials && speaker.socials.length > 0 && (
                            <div
                              class="flex items-center gap-3"
                              role="list"
                              aria-label={`Redes sociales de ${speaker.name}`}
                            >
                              {speaker.socials.map(({ platform, url }) => (
                                <SocialNetworksBwai2026 name={speaker.name} {platform} {url} />
                              ))}
                            </div>
                          )}

                          <div class="flex flex-col gap-1.5 mt-4">
                            <p class={`text-gdg-off-white/60 text-sm md:min-h-16 lg:min-h-12 font-medium leading-relaxed`}>
                              {speaker.talkTitle}
                            </p>
                          </div>

                          <p
                            class="text-gdg-off-white/60 leading-relaxed pt-1 line-clamp-3 text-sm transition-all duration-300"
                            data-talk-description
                          >
                            {speaker.talkDescription}
                          </p>

                          <!-- Expandir bio -->
                          <div class="mt-auto pt-3 border-t border-gdg-midnight-blue/20">
                            <button
                              class="flex items-center gap-1.5 text-xs font-medium text-gdg-midnight-blue hover:text-gdg-ice-blue focus-visible:text-gdg-ice-blue focus-visible:outline-none transition-colors duration-200 cursor-pointer"
                              aria-expanded="false"
                              aria-controls={`speaker-details-${speaker.id}`}
                              data-speaker-toggle
                              type="button"
                            >
                              <span class="toggle-label">Ver más</span>
                              <svg
                                class="w-3.5 h-3.5 toggle-icon transition-transform duration-300"
                                viewBox="0 0 16 16"
                                fill="none"
                                aria-hidden="true"
                              >
                                <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                              </svg>
                            </button>

                            <div
                              id={`speaker-details-${speaker.id}`}
                              class="speaker-details mt-3"
                              aria-hidden="true"
                            >
                              <span class="text-gdg-deep-ocean-blue text-sm">Conoce a {speaker.name}</span>
                              <p class="text-gdg-off-white/60 text-sm leading-relaxed pt-3">
                                {speaker.aboutSpeaker}
                              </p>
                            </div>
                          </div>
                        </div>

                      </div>
                    </div>
                  </article>
                </div>
              ))}
              </div>
            )}
          </div>
        );
      })}

  </div>
</section>

<style>
  /* ── Transición de panels ─────────────────── */
  [data-speakers-panel] {
    opacity: 0;
    transform: translateY(10px);
    transition: opacity .4s ease, transform .4s ease;
  }
  [data-speakers-panel].is-visible {
    opacity: 1;
    transform: none;
  }

  .speaker-card-blue   { border-color: rgba(66,133,244,.2); box-shadow: 0 6px 16px -8px rgba(66,133,244,.22); }
  .speaker-card-green  { border-color: rgba(52,168,83,.2); box-shadow: 0 6px 16px -8px rgba(52,168,83,.22); }
  .speaker-card-yellow { border-color: rgba(249,171,0,.2); box-shadow: 0 6px 16px -8px rgba(249,171,0,.22); }

  /* ── Bio expandible ──────────────────────── */
  .speaker-details {
    max-height: 0;
    overflow: hidden;
    transition: max-height .35s ease-in-out;
  }
  [aria-expanded="true"] .toggle-icon { transform: rotate(180deg); }

  /* ── Animaciones de entrada ──────────────── */
  [data-animate] {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity .6s ease, transform .6s ease;
  }
  [data-animate].is-visible { opacity: 1; transform: none; }

  [data-stagger="0"] { transition-delay:   0ms; }
  [data-stagger="1"] { transition-delay: 100ms; }
  [data-stagger="2"] { transition-delay: 200ms; }
  [data-stagger="3"] { transition-delay: 300ms; }
  [data-stagger="4"] { transition-delay: 400ms; }

  @media (prefers-reduced-motion: reduce) {
    [data-animate], [data-speakers-panel] {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  /* ── Placeholder "Próximamente" ──────────────── */
  .spk-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 2.5rem 1rem 3rem;
    text-align: center;
  }

  /* Grid de ghost cards */
  .spk-ghost-wrap {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: .75rem;
    margin-bottom: 2rem;
  }

  .spk-ghost {
    border-radius: 14px;
    border: 1px solid rgba(255,255,255,.07);
    background: rgba(255,255,255,.025);
    overflow: hidden;
    position: relative;
    display: flex;
    flex-direction: column;
  }

  /* Efecto shimmer sobre cada ghost card */
  .spk-ghost::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent 0%, rgba(255,255,255,.05) 50%, transparent 100%);
    animation: spk-shimmer 2.6s ease-in-out infinite;
  }
  .spk-ghost-side:first-child::after { animation-delay: .4s; }
  .spk-ghost-side:last-child::after  { animation-delay: .8s; }

  @keyframes spk-shimmer {
    0%   { transform: translateX(-150%); }
    100% { transform: translateX(150%); }
  }

  /* Tamaños: centro destacado, laterales recesados */
  .spk-ghost-center { width: 170px; height: 220px; }
  .spk-ghost-side   { width: 130px; height: 180px; opacity: .45; }

  /* Contenido interno del ghost (skeleton) */
  .spk-skel-photo {
    width: 100%;
    flex: 1;
    background: rgba(255,255,255,.04);
    border-bottom: 1px solid rgba(255,255,255,.05);
  }
  .spk-skel-body {
    padding: .6rem .75rem;
    display: flex;
    flex-direction: column;
    gap: .45rem;
  }
  .spk-skel-line {
    height: 7px;
    border-radius: 4px;
    background: rgba(255,255,255,.07);
    width: 65%;
  }
  .spk-skel-line-short { width: 40%; }
  .spk-skel-line-long  { width: 85%; }
  .spk-skel-line-mid   { width: 55%; }

  /* Badge "Próximamente" */
  .spk-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 14px;
    border-radius: 20px;
    border: 1px solid rgba(255,255,255,.1);
    background: rgba(255,255,255,.04);
    color: rgba(255,255,255,.5);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: .1em;
    text-transform: uppercase;
    margin-bottom: .6rem;
  }

  /* Badge tematizado según el color del milestone */
  [data-milestone-color="blue"]   .spk-badge { border-color: rgba(66,133,244,.25);  color: rgba(66,133,244,.75);  background: rgba(66,133,244,.06); }
  [data-milestone-color="green"]  .spk-badge { border-color: rgba(52,168,83,.25);   color: rgba(52,168,83,.75);   background: rgba(52,168,83,.06); }
  [data-milestone-color="yellow"] .spk-badge { border-color: rgba(249,171,0,.25);   color: rgba(249,171,0,.75);   background: rgba(249,171,0,.06); }

  [data-milestone-color="blue"]   .spk-badge-dot { background: rgba(66,133,244,.7); }
  [data-milestone-color="green"]  .spk-badge-dot { background: rgba(52,168,83,.7);  }
  [data-milestone-color="yellow"] .spk-badge-dot { background: rgba(249,171,0,.7);  }

  @keyframes spk-pulse {
    0%, 100% { opacity: 1;  transform: scale(1); }
    50%       { opacity: .3; transform: scale(.7); }
  }
  .spk-badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgba(255,255,255,.4);
    animation: spk-pulse 2s ease-in-out infinite;
    flex-shrink: 0;
  }

  .spk-badge-date {
    font-size: 12px;
    color: rgba(255,255,255,.25);
    margin: 0;
    letter-spacing: .04em;
  }

  @media (prefers-reduced-motion: reduce) {
    .spk-ghost::after, .spk-badge-dot { animation: none; }
  }
</style>

<script>
  // ── IntersectionObserver para animaciones de entrada ───────────────
  let animObserver: IntersectionObserver;

  function buildObserver(): void {
    animObserver = new IntersectionObserver(
      entries => entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          animObserver.unobserve(entry.target);
        }
      }),
      { threshold: 0.1 }
    );
  }

  // ── Mostrar/ocultar panel ──────────────────────────────────────────
  function showPanel(id: string): void {
    document.querySelectorAll<HTMLElement>('[data-speakers-panel]').forEach(panel => {
      if (panel.dataset.milestoneId === id) {
        // Mostrar: quitar hidden → próximo frame → fade in + observar elementos
        panel.removeAttribute('hidden');
        requestAnimationFrame(() => {
          panel.classList.add('is-visible');
          panel.querySelectorAll<HTMLElement>('[data-animate]').forEach(el => {
            el.classList.remove('is-visible');
            animObserver.observe(el);
          });
        });
      } else if (panel.classList.contains('is-visible')) {
        // Ocultar: fade out → poner hidden al terminar la transición
        panel.classList.remove('is-visible');
        panel.addEventListener(
          'transitionend',
          () => { if (!panel.classList.contains('is-visible')) panel.setAttribute('hidden', ''); },
          { once: true }
        );
      }
    });
  }

  // ── Determinar el milestone activo por fecha ───────────────────────
  // Prioridad: activo/próximo → si todos pasaron, el más reciente
  // Esto garantiza que los speakers del siguiente evento sean los visibles por defecto.
  // Los milestones pasados siguen siendo accesibles mediante click en su card.
  function getActiveId(panels: NodeListOf<HTMLElement>): string | null {
    const today = new Date();
    today.setHours(0, 0, 0, 0);
    const sorted = [...panels]
      .map(p => p.dataset.milestoneId!)
      .filter(Boolean)
      .sort();

    // Primer milestone cuya fecha no ha pasado aún (activo o futuro)
    for (const iso of sorted) {
      if (new Date(iso + 'T00:00:00') >= today) return iso;
    }
    // Todos pasaron → mostrar el más reciente (tiene speakers aunque haya terminado)
    return sorted[sorted.length - 1] ?? null;
  }

  // ── Handler con referencia estable (permite removeEventListener) ───
  function handleMilestoneSelect(e: Event): void {
    showPanel((e as CustomEvent<{ id: string }>).detail.id);
  }

  // ── Speaker toggle (bio expandible) ───────────────────────────────
  function initSpeakerToggles(): void {
    document.querySelectorAll<HTMLButtonElement>('[data-speaker-toggle]').forEach(btn => {
      btn.addEventListener('click', () => {
        const expanded = btn.getAttribute('aria-expanded') === 'true';
        const content = document.getElementById(btn.getAttribute('aria-controls') ?? '');
        const desc = btn.closest('.speaker-card')?.querySelector('[data-talk-description]');
        if (!content) return;

        btn.setAttribute('aria-expanded', String(!expanded));
        content.setAttribute('aria-hidden', String(expanded));

        if (!expanded) {
          desc?.classList.remove('line-clamp-3');
          content.style.maxHeight = content.scrollHeight + 'px';
        } else {
          desc?.classList.add('line-clamp-3');
          content.style.maxHeight = '';
        }

        const label = btn.querySelector('.toggle-label');
        if (label) label.textContent = expanded ? 'Ver más' : 'Ver menos';
      });
    });
  }

  // ── Init principal ─────────────────────────────────────────────────
  function initSpeakersRoad(): void {
    buildObserver();

    const panels = document.querySelectorAll<HTMLElement>('[data-speakers-panel]');
    if (!panels.length) return;

    // Estado inicial determinado por fecha (independiente de RoadToBuild)
    const activeId = getActiveId(panels);
    if (activeId) showPanel(activeId);

    // Listener para cambios por interacción del usuario
    document.removeEventListener('rtb:milestone-select', handleMilestoneSelect);
    document.addEventListener('rtb:milestone-select', handleMilestoneSelect);

    initSpeakerToggles();
  }

  document.addEventListener('DOMContentLoaded', initSpeakersRoad);
  document.addEventListener('astro:page-load', initSpeakersRoad);
</script>
