---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import speakers from './speakers-road.json'
import SocialNetworksBwai2026 from './SocialNetworksBwai2026.astro';

type Level = 'Introductorio' | 'Intermedio' | 'Avanzado';

const levelStyles: Record<Level, { dot: string; text: string }> = {
  Introductorio:     { dot: 'bg-gdg-green',  text: 'text-gdg-green'  },
  Intermedio: { dot: 'bg-gdg-yellow', text: 'text-gdg-yellow' },
  Avanzado:     { dot: 'bg-gdg-red',    text: 'text-gdg-red'    },
};

---

<section
  id="speakers-road"
  aria-labelledby="speakers-road-title"
  class="relative bg-bwai-background px-4 py-12 md:py-20 overflow-hidden border-t border-gray-800"
>
  

  <div class="relative max-w-7xl mx-auto px-6 xl:px-14">
    <header class="mb-9 md:mb-12" data-animate data-stagger="0">
      <p class="text-gdg-blue font-medium text-sm sm:text-base
                tracking-wider mb-2">
        Conferencia Online · Sesión 1
      </p>
      <h2
        id="speakers-road-title"
        class="text-2xl md:text-3xl font-bold text-gdg-off-white mb-3 leading-tight"
      >
        Speakers Road to Build
      </h2>
      <p class="text-sm text-gdg-midnight-blue leading-relaxed max-w-sm">
        Conoce a los speakers de la primera sesión online.
      </p>
    </header>

    <div class="relative">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5 justify-items-center">
        {
          speakers.map((speaker, index) => (
            <div class="flex flex-col gap-3 max-w-sm w-full" data-animate data-stagger={index + 1}>
              <article
                class="speaker-card group w-full flex flex-col"
                aria-label={`Speaker: ${speaker.name}`}
              >
                <div class="rounded-2xl p-px flex flex-col h-full speaker-card-border">
                  <div class="rounded-[15px] bg-bwai-background overflow-hidden flex flex-col h-full">
                    <div class="relative overflow-hidden h-70 shrink-0">
                      <span
                        class="absolute bottom-3 right-3 flex items-center gap-1.5 bg-bwai-background/80 text-gdg-off-white text-[10px] font-medium px-2.5 py-1 rounded-full"
                        aria-label={`Speaker de ${speaker.location.city}, ${speaker.location.country}`}
                      >
                        <span aria-hidden="true">{speaker.location.flag}</span>
                        {speaker.location.city}, {speaker.location.country}
                      </span>
                      <Image
                        src={speaker.photo}
                        alt={`Foto de ${speaker.name}`}
                        width={400}
                        height={280}
                        class="w-full h-full object-cover object-top"
                      />
                      <div
                        class="absolute inset-0 bg-linear-to-t from-bwai-background/50 via-transparent to-transparent pointer-events-none"
                        aria-hidden="true"
                      />
                    </div>
                    <div class="flex flex-col flex-1 p-5 gap-2">
                      <h3 class="text-gdg-off-white font-semibold text-base leading-snug">
                        {speaker.name}
                      </h3>
                      {
                        speaker.socials && speaker.socials.length > 0 && (
                          <div class="flex items-center gap-3" role="list" aria-label={`Redes sociales de ${speaker.name}`}>
                            {speaker.socials.map(({platform, url }) => (
                              <SocialNetworksBwai2026 name={speaker.name} {platform} {url} />
                            ))}
                          </div>
                        )
                      }
                      <div class="flex flex-col gap-1.5 mt-4">
                        <span
                          class={`flex items-center gap-1.5 w-fit text-[10px] font-semibold tracking-widest uppercase ${levelStyles[speaker.level as Level].text}`}
                          aria-label={`Nivel de la charla: ${speaker.level}`}
                        >
                          <span
                            class={`w-1.5 h-1.5 rounded-full ${levelStyles[speaker.level as Level].dot} opacity-80`}
                            aria-hidden="true"
                          />
                          {speaker.level}
                        </span>
                        <p class="text-gdg-halftone-blue md:min-h-16 lg:min-h-12 text-sm font-medium leading-relaxed">
                          {speaker.talkTitle}
                        </p>
                      </div>
                      <p class="text-gdg-off-white/60 leading-relaxed pt-3 line-clamp-3 transition-all duration-300" data-talk-description>
                        {speaker.talkDescription}
                      </p>
                      <div class="mt-auto pt-3 border-t border-gdg-midnight-blue/20">
                        <button
                          class="flex items-center gap-1.5 text-xs font-medium text-gdg-midnight-blue hover:text-gdg-ice-blue focus-visible:text-gdg-ice-blue focus-visible:outline-none transition-colors duration-200 cursor-pointer"
                          aria-expanded="false"
                          aria-controls={`speaker-details-${speaker.id}`}
                          data-speaker-toggle
                        >
                          <span class="toggle-label">Ver más</span>
                          <svg
                            class="w-3.5 h-3.5 toggle-icon transition-transform duration-300"
                            viewBox="0 0 16 16"
                            fill="none"
                            aria-hidden="true"
                          >
                            <path
                              d="M4 6l4 4 4-4"
                              stroke="currentColor"
                              stroke-width="1.5"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                            />
                          </svg>
                        </button>
                        <div
                          id={`speaker-details-${speaker.id}`}
                          class="speaker-details  mt-3"
                          aria-hidden="true"
                        >
                          <span class="text-gdg-deep-ocean-blue text-sm">Conoce a {speaker.name}</span>
                          <p class="text-gdg-off-white/60 text-sm leading-relaxed pt-3">
                            {speaker.aboutSpeaker}
                          </p>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </article>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .speakers-bg-glow {
    background: radial-gradient(
      ellipse 70% 50% at 50% 0%,
      rgba(36, 128, 240, 0.07) 0%,
      transparent 70%
    );
  }

  .road-connector {
    height: 1px;
    background-image: repeating-linear-gradient(
      to right,
      rgba(22, 81, 133, 0.55) 0px,
      rgba(22, 81, 133, 0.55) 6px,
      transparent 6px,
      transparent 14px
    );
  }
  .road-node {
    width: 14px;
    height: 14px;
    border-radius: 9999px;
    position: relative;
    z-index: 10;
    flex-shrink: 0;
  }

  .road-node--active {
    background-color: var(--color-gdg-deep-ocean-blue);
    box-shadow:
      0 0 0 4px rgba(36, 128, 240, 0.2),
      0 0 14px rgba(36, 128, 240, 0.4);
  }

  .road-node--locked {
    background-color: var(--color-bwai-background);
    border: 2px solid rgba(22, 81, 133, 0.4);
  }

  .speaker-card-border {
    background: linear-gradient(
      155deg,
      rgba(36, 128, 240, 0.85) 0%,
      rgba(87, 202, 255, 0.4) 45%,
      rgba(36, 128, 240, 0.06) 100%
    );
    box-shadow:
      0 0 28px rgba(36, 128, 240, 0.1),
      0 12px 40px rgba(0, 0, 0, 0.45);
  }

  .speaker-details {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.35s ease-in-out;
  }

  [aria-expanded='true'] .toggle-icon {
    transform: rotate(180deg);
  }
  [data-animate] {
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 0.6s ease,
      transform 0.6s ease;
  }

  [data-animate].is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  [data-stagger='0'] {
    transition-delay: 0ms;
  }
  [data-stagger='1'] {
    transition-delay: 100ms;
  }
  [data-stagger='2'] {
    transition-delay: 200ms;
  }
  [data-stagger='3'] {
    transition-delay: 300ms;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-animate] {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-speaker-toggle]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      const targetId = btn.getAttribute('aria-controls');
      const content = targetId ? document.getElementById(targetId) : null;

      const speakerCard = btn.closest('.speaker-card');
      const talkDescription = speakerCard?.querySelector('[data-talk-description]');

      if (!content) return;

      btn.setAttribute('aria-expanded', String(!isExpanded));
      content.setAttribute('aria-hidden', String(isExpanded));
      if (!isExpanded) {
        talkDescription?.classList.remove('line-clamp-3');
        content.style.maxHeight = `${content.scrollHeight}px`;
      } else {
        talkDescription?.classList.add('line-clamp-3');
        content.style.maxHeight = '';
      }

      const label = btn.querySelector('.toggle-label');
      if (label) label.textContent = isExpanded ? 'Ver más' : 'Ver menos';
    });
  });

  const animObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          animObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1 },
  );

  document.querySelectorAll('[data-animate]').forEach((el) => animObserver.observe(el));
</script>
