---
import sponsors from './sponsors.json';
import collaborators from './collaborators.json';
import { Image } from 'astro:assets';

const cardBaseClasses =
  'group ring-1 ring-transparent transition-all duration-300 bg-white/1.5 border border-white/6';
const hoverElevation =
  'hover:-translate-y-1.5 hover:bg-[#111e2d] hover:border-[#1f3251] hover:shadow-[0_12px_36px_rgba(0,0,0,0.45),_inset_0_0_0_1px_rgba(255,255,255,0.03)]';
---

<section
  id="sponsors"
  aria-labelledby="sponsors-title"
  class="relative w-full overflow-hidden bg-bwai-background px-4 py-18 sm:px-6 lg:px-8 border-t border-gray-800"
>
  <div class="relative z-10 mx-auto max-w-6xl">
    <header class="mb-8 flex items-center gap-3">
      <h2 id="collaboratos-title" class="text-xl lg:text-2xl font-medium tracking-tight text-white">
        Colaboradores
      </h2>
      <div class="flex h-9 w-9 shrink-0 items-center justify-center" aria-hidden="true">
        <svg
          class="h-8 w-8 text-orange-400"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="currentColor"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="18" cy="5" r="3"></circle>
          <circle cx="6" cy="12" r="3"></circle>
          <circle cx="18" cy="19" r="3"></circle>
          <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
          <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
        </svg>
      </div>
    </header>

    <div class="mb-16" role="group" aria-label="Colaboradores">
      <ul class="flex flex-wrap justify-center gap-5" role="list">
        {
          collaborators.map((c) => (
            <li>
              <a
                href={c.website}
                target="_blank"
                rel="noopener noreferrer"
                class:list={[
                  'flex items-center gap-3 px-5 py-4 rounded-md',
                  cardBaseClasses,
                  hoverElevation,
                  c.ringClass,
                ]}
                aria-label={`${c.name}, sitio web del colaborador`}
              >
                <Image
                  src={c.logo}
                  alt={`${c.name} logo`}
                  height={76}
                  width={210}
                  decoding="async"
                  class="h-13 md:h-15 lg:h-19 w-auto transition-all duration-500 group-hover:scale-105 group-hover:grayscale-0"
                />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <div
      class="mt-18 border-t text-center border md:max-w-xl rounded-md border-white/6 bg-white/1.5 p-8 mx-auto"
    >
      <div class="max-w-xl mx-auto space-y-4">
        <h3 class="text-xl font-medium tracking-tight text-white">
          ¿Quieres apoyar a la comunidad?
        </h3>

        <p class="text-xs text-gray-400 leading-relaxed max-w-md mx-auto">
          Forma parte de nuestros eventos y conecta con el talento tecnológico local. Haz click en
          el boton para conocer nuestros niveles de patrocinio.
        </p>

        <div class="pt-4 flex flex-row items-center justify-center gap-6">
          <a
            href="https://gdgtarija.com/call4sponsors/"
            target="_blank"
            class="group inline-flex md:w-39 justify-center items-center gap-1 text-xs font-semibold px-5 py-3 rounded-md bg-gdg-blue hover:bg-[#3367D6] hover:shadow-[0_0_10px_rgba(66,133,244,0.55)] text-white transition-colors duration-200 focus-visible:outline-none focus-visible:underline"
          >
            Regístrate
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="2.5"
              stroke="currentColor"
              class="h-3 w-3 transition-transform duration-200 group-hover:translate-x-0.5"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"></path>
            </svg>
          </a>
          <a
            href="https://docs.google.com/document/d/1t33oD9OfBEGxqvxsih7QCN1uaEnmVgiD/edit?usp=sharing&ouid=102157576605899365843&rtpof=true&sd=true"
            target="_blank"
            class="group inline-flex md:w-39 items-center gap-1 text-xs font-semibold px-5 py-3 rounded-md outline outline-bwai-border text-white/80 shadow-[0_0_5px_rgba(103,136,181,0.35)]
                hover:shadow-[0_0_10px_rgba(121,143,174,0.55)] transition-colors duration-200 focus-visible:outline-none focus-visible:underline"
          >
            Ver convocatoria
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 320 512"
              fill="currentColor"
              width="10"
              height="14"
              class="relative z-10 group-hover:translate-x-1 transition-transform"
              aria-hidden="true"
            >
              <path
                d="M310.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-192 192c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L242.7 256 73.4 86.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l192 192z"
              ></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
