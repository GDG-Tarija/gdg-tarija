---
import { Image } from 'astro:assets';
import LogoUCB from '../../assets/images/bwai2026/logo-ucb.webp';
import VenueUCB from '../../assets/images/bwai2026/venue-ucb.webp';

const mapsUrl =
  'https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d1882.2610662029092!2d-64.7319935!3d-21.5325957!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x940647e26f0a44d7%3A0x92569daaf01ac3f8!2sUniversidad%20Catolica%20Boliviana%20%22San%20Pablo%22%20Regional%20Tarija!5e1!3m2!1sen!2sbo!4v1779651580154!5m2!1sen!2sbo';
---

<section id="about" class="bg-bwai-background pt-10" aria-labelledby="about-heading">
  <div class="border-t border-gray-800">
    <div
      class="max-w-7xl px-6 w-full xl:px-14 mx-auto flex flex-col lg:flex-row gap-3 lg:gap-8 items-start"
    >
      <!-- ── LEFT: About the Event ─────────────────────────────── -->
      <div
        class="about-text opacity-0 basis-[40%] w-full translate-y-8 transition-[opacity,transform] duration-700 ease-out mb-10"
      >
        <!-- { } + Heading -->
        <div class="flex items-center gap-4 mb-6 pt-10">
          <span
            class="text-gdg-blue text-4xl font-medium font-mono leading-none select-none"
            aria-hidden="true">&#123;&#125;</span
          >
          <h2 id="about-heading" class="text-white text-xl lg:text-2xl font-medium">
            About the Event
          </h2>
        </div>

        <!-- Descripción -->
        <div class="space-y-4 mb-6 ms-14.5">
          <p class="text-white/65 text-base leading-relaxed font-light lg:font-medium xl:text-xl">
            Build with AI es un evento enfocado en el aprendizaje práctico de Inteligencia
            Artificial, donde los participantes podrán adquirir conocimientos, desarrollar
            habilidades y aplicar herramientas actuales mediante talleres y charlas.
          </p>
        </div>

        <!-- Tagline -->
        <p
          class="text-gdg-green font-mono text-sm tracking-widest ms-14.5"
          aria-label="learn, connect, build"
        >
          // learn. connect. build.
        </p>
      </div>

      <!-- ── RIGHT: Ubicación ──────────────────────────────────── -->
      <div
        class="location-block pt-8 h-full basis-[60%] w-full md:w-5/6 self-center opacity-0 translate-y-8 transition-[opacity,transform] duration-700 ease-out delay-150 ps-0 lg:ps-8 lg:border-l border-gray-800"
      >
        <!-- Header -->
        <div class="flex items-center justify-between mt-1">
          <h2 class="text-white text-xl lg:text-2xl font-medium">Ubicación</h2>
          <span class="text-gdg-yellow text-2xl lg:text-4xl font-bold font-mono select-none" aria-hidden="true"
            >&lt;&nbsp;&gt;</span
          >
        </div>

        <!-- Flip Card: el contenedor aplica la perspectiva 3D -->
        <div
          class="flex flex-col md:flex-row perspective-distant gap-6 items-center justify-center"
        >
          <!-- Logo UCB — overlay esquina inferior izquierda -->
          <div class="shadow-lg hidden md:flex pointer-events-none ps-0 w-33 lg:ps-4 justify-items-center" aria-hidden="true">
            <Image
              src={LogoUCB}
              alt="Universidad Católica Boliviana"
              class="h-auto w-auto"
              loading="lazy"
            />
          </div>
          <div class="shadow-lg md:hidden pointer-events-none border w-1/3 p-2 border-[#004177] rounded-xl bg-[#004177] justify-items-center" aria-hidden="true">
            <Image
              src="/img/events/bwai2026/logo-ucb_ucb.png"
              alt="Universidad Católica Boliviana"
              width={140}
              height={65}
              class="h-auto w-auto"
              loading="lazy"
            />
          </div>
          <div class="flip-card relative w-full aspect-4/3 h-63 lg:h-68.25 md:me-12" id="venueFlipCard">
            <!-- FRENTE: Foto del venue + logo UCB -->
            <div
              class="flip-face absolute inset-0 rounded-2xl overflow-hidden cursor-pointer group"
              id="flipFront"
              role="button"
              tabindex="0"
              aria-label="Haz click para ver la ubicación en Google Maps"
            >
              <!-- Foto principal del venue -->
              <Image
                src={VenueUCB}
                alt="Campus de la Universidad Católica Boliviana, Tarija"
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
                decoding="async"
              />

              <!-- Hint hover -->
              <div
                class="absolute inset-0 flex items-center justify-center bg-gdg-blue/0 group-hover:bg-gdg-blue/10 transition-colors duration-300"
                aria-hidden="true"
              >
                <div
                  class="flex items-center gap-2 opacity-0 translate-y-2 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-300 bg-bwai-background/80 backdrop-blur-sm border border-white/15 rounded-full px-5 py-2"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-4 h-4 text-gdg-blue shrink-0"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                    ></path>
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                  </svg>
                  <span class="text-white text-sm font-medium">Ver en el mapa</span>
                </div>
              </div>
            </div>

            <!-- REVERSO: Google Maps iframe -->
            <div class="flip-face flip-face--back absolute inset-0 rounded-2xl overflow-hidden">

              <iframe
                id="venueMapIframe"
                src=""
                data-src={mapsUrl}
                class="w-full h-full border-0"
                allowfullscreen
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                title="Mapa del venue — Universidad Católica Boliviana, Tarija"></iframe>

              <!-- Botón volver -->
              <button
                id="flipBackBtn"
                class="absolute top-3 right-3 flex items-center gap-2 bg-bwai-background/85 backdrop-blur-md border border-white/10 text-white text-sm font-medium rounded-full px-4 py-2 hover:bg-white/10 transition-colors duration-200 cursor-pointer"
                aria-label="Volver a la imagen del venue"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-4 h-4 shrink-0"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                </svg>
                Volver
              </button>
            </div>
          </div>
        </div>
        <!-- /Flip Card -->

        <!-- Caption -->
        <p class="mt-3 flex items-center gap-1.5 text-white/35 text-xs font-mono justify-end mb-10">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-3 h-3 text-gdg-blue shrink-0"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2.5"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5"></path>
          </svg>
          Click en la imagen para ver el mapa
        </p>
      </div>
      <!-- /RIGHT -->
    </div>
  </div>
</section>

<style>
  .flip-card {
    transform-style: preserve-3d;
    transition: transform 0.65s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .flip-card.is-flipped {
    transform: rotateY(180deg);
  }

  .flip-face {
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  .flip-face--back {
    transform: rotateY(180deg);
  }
</style>

<script>
  // ── Flip Card ────────────────────────────────────────────────
  const card = document.getElementById('venueFlipCard');
  const front = document.getElementById('flipFront');
  const backBtn = document.getElementById('flipBackBtn');
  const iframe = document.getElementById('venueMapIframe') as HTMLIFrameElement | null;

  let isFlipped = false;
  let mapLoaded = false; // evita recargar el iframe en flips sucesivos

  function flipToMap(): void {
    if (isFlipped || !card || !iframe) return;
    isFlipped = true;
    card.classList.add('is-flipped');

    // Lazy-load: inyectar src a los 320ms (mitad del flip)
    // para que el mapa cargue mientras la animación termina.
    setTimeout(() => {
      if (!mapLoaded && iframe.dataset.src) {
        iframe.src = iframe.dataset.src;
        mapLoaded = true;
      }
    }, 320);
  }

  function flipToVenue(): void {
    if (!isFlipped || !card) return;
    isFlipped = false;
    card.classList.remove('is-flipped');
  }

  front?.addEventListener('click', flipToMap);

  // Soporte de teclado (accesibilidad — role="button" requiere Enter y Space)
  front?.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault();
      flipToMap();
    }
  });

  // stopPropagation: defensa por si el botón y el frente comparten
  // algún ancestro con listener en el futuro.
  backBtn?.addEventListener('click', (e: MouseEvent) => {
    e.stopPropagation();
    flipToVenue();
  });

  // ── Scroll Entrance Animations ───────────────────────────────
  // Estrategia: las clases Tailwind opacity-0 y translate-y-8 se aplican
  // como estado inicial en el HTML. El observer las elimina al entrar
  // en el viewport, activando la transición CSS declarada con Tailwind.
  const targets = document.querySelectorAll<HTMLElement>('.about-text, .location-block');

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          // Remover las clases de estado inicial dispara la transición Tailwind
          entry.target.classList.remove('opacity-0', 'translate-y-8');
          observer.unobserve(entry.target); // ejecutar solo una vez
        }
      });
    },
    { threshold: 0.12 },
  );

  targets.forEach((el) => observer.observe(el));
</script>