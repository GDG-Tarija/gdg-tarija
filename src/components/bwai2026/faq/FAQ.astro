---
const colors = [
  {
    idx:        'text-gdg-blue',
    openBorder: 'open:border-gdg-blue/40',
    openBg:     'open:bg-gdg-blue/5',
    iconOpen:   'group-open:text-gdg-blue',
  },
  {
    idx:        'text-gdg-red',
    openBorder: 'open:border-gdg-red/40',
    openBg:     'open:bg-gdg-red/5',
    iconOpen:   'group-open:text-gdg-red',
  },
  {
    idx:        'text-gdg-green',
    openBorder: 'open:border-gdg-green/40',
    openBg:     'open:bg-gdg-green/5',
    iconOpen:   'group-open:text-gdg-green',
  },
  {
    idx:        'text-gdg-yellow',
    openBorder: 'open:border-gdg-yellow/40',
    openBg:     'open:bg-gdg-yellow/5',
    iconOpen:   'group-open:text-gdg-yellow',
  },
];

import Faqs from './faq.json'
---

<section
  id="faq"
  aria-labelledby="faq-heading"
  class="relative overflow-hidden bg-bwai-background py-14 border-t border-gray-800
        before:pointer-events-none before:absolute before:inset-0 before:content-['']
        before:bg-[radial-gradient(circle,rgba(255,255,255,0.04)_1px,transparent_1px)]
        before:bg-size-[28px_28px]"
>
  <div class="relative z-10 mx-auto max-w-7xl px-6 xl:px-16 ">

    <!-- ── Encabezado de sección ───────────────────────────────── -->
    <div class="mb-10 animate-[fadeSlideUpFaq_0.6s_ease_both]">
      <p class="mb-3 font-mono font-extrabold text-3xl tracking-widest text-gdg-green" aria-hidden="true">
        {"{ ? }"}
      </p>
      <h2 id="faq-heading" class="mb-4 text-[clamp(1.25rem,5vw,1.6rem)] font-bold leading-tight text-white">
        Preguntas Frecuentes
      </h2>
      <p class="text-base leading-relaxed text-neutral-400">
        ¿Tienes dudas? Aquí están las respuestas a las preguntas más comunes sobre el evento.
      </p>
    </div>

    <!-- ── Lista de acordeones ─────────────────────────────────── -->
    <div class="flex flex-col gap-2 mx-auto md:max-w-xl lg:max-w-4xl" role="list">
      {
        Faqs.map((faq, index) => {
          const color = colors[index % 4];
          return (
            <details
              role="listitem"
              class={`faq-item group overflow-hidden rounded-xl border border-white/6
                      bg-bwai-border transition-colors duration-200
                      hover:border-white/12 hover:bg-[#1d2530]
                      ${color.openBorder} ${color.openBg}`}
            >
              <summary
                class="flex cursor-pointer select-none items-center gap-4 px-6 py-5
                      [&::-webkit-details-marker]:hidden [&::marker]:hidden"
                aria-expanded="false"
              >
                {/* Número de índice — coloreado según variante */}
                <span
                  class={`min-w-[1.8rem] shrink-0 font-mono text-[0.7rem]
                          tracking-[0.05em] opacity-70 ${color.idx}`}
                  aria-hidden="true"
                >
                  {String(index + 1).padStart(2, '0')}
                </span>

                {/* Pregunta */}
                <span
                  class="flex-1 text-base font-medium leading-snug text-[#e8eaed]
                        transition-colors duration-200 group-open:text-white"
                >
                  {faq.question}
                </span>

                {/* Icono +/− */}
                <span
                  class={`flex shrink-0 items-center justify-center
                          text-neutral-500 transition-colors duration-200 ${color.iconOpen}`}
                  aria-hidden="true"
                >
                  <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                    <line class="icon-h" x1="4" y1="10" x2="16" y2="10"
                          stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
                    <line class="icon-v" x1="10" y1="4" x2="10" y2="16"
                          stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
                  </svg>
                </span>
              </summary>

              {/* Respuesta — indentada al nivel del texto de la pregunta */}
              <div class="px-6 pb-5 pl-[calc(1.5rem+1.8rem+1rem)]">
                <p class="text-[0.9375rem] leading-[1.7] text-neutral-400">
                  {faq.answer}
                </p>
              </div>
            </details>
          );
        })
      }
    </div>

  </div>
</section>

<style>

  @keyframes fadeSlideUpFaq {
    from { opacity: 0; transform: translateY(14px); }
    to   { opacity: 1; transform: translateY(0);    }
  }

  /* Estado inicial oculto; JS añade .is-visible para disparar la animación */
  .faq-item {
    opacity: 0;
    transform: translateY(12px);
  }

  .faq-item.is-visible {
    animation: fadeSlideUpFaq 0.45s ease forwards;
  }

  /* Delays escalonados por posición — sin estilos en línea */
  .faq-item:nth-child(1).is-visible  { animation-delay:   0ms; }
  .faq-item:nth-child(2).is-visible  { animation-delay:  70ms; }
  .faq-item:nth-child(3).is-visible  { animation-delay: 140ms; }
  .faq-item:nth-child(4).is-visible  { animation-delay: 210ms; }
  .faq-item:nth-child(5).is-visible  { animation-delay: 280ms; }
  .faq-item:nth-child(6).is-visible  { animation-delay: 350ms; }
  .faq-item:nth-child(7).is-visible  { animation-delay: 420ms; }
  .faq-item:nth-child(8).is-visible  { animation-delay: 490ms; }

  /* Animación del icono SVG — selector compuesto, imposible con Tailwind */
  .icon-v {
    transform-origin: center;
    transition:
      transform 0.25s cubic-bezier(0.4, 0, 0.2, 1),
      opacity   0.2s  ease;
  }

  details[open] .icon-v {
    transform: scaleY(0);
    opacity: 0;
  }
</style>

<script>
  // Intersection Observer para la entrada escalonada al hacer scroll
  const items = document.querySelectorAll<HTMLElement>('.faq-item');

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1 },
  );

  items.forEach((item) => observer.observe(item));

  // Accesibilidad: sincronizar aria-expanded con el estado del acordeón
  document.querySelectorAll<HTMLDetailsElement>('.faq-item').forEach((det) => {
    const summary = det.querySelector('summary');
    if (!summary) return;
    det.addEventListener('toggle', () => {
      summary.setAttribute('aria-expanded', String(det.open));
    });
  });
</script>