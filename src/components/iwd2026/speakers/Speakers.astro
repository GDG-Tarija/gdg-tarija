---
import "./speakers.css";
import speakers from "./speakers.json";

const icons: Record<string, string> = {
  facebook: 'fa-brands fa-facebook',
  instagram: 'fa-brands fa-instagram',
  linkedin: 'fa-brands fa-linkedin',
  youtube: 'fa-brands fa-youtube',
  tiktok: 'fa-brands fa-tiktok',
  github: 'fa-brands fa-github',
  web: 'fa-solid fa-globe',
  website: 'fa-solid fa-globe',
};
---
<article id="speakers" class="speakers-container">
    <h4 class="speakers-title">Speakers</h4>
    <h1 class="speakers-large-title">Conoce a las voces del cambio</h1>
    <hr class="speakers-line">

    <section class="speakers-list">
  {speakers.map((item) =>

                <section class="speaker-card">
                        <hr class="speaker-card-line">
                        <div class="speaker-photo">
                            <img src={item.img_path} alt={item.name}/>
                        </div>
                        <div class="speaker-name">{item.name}</div>
                        <div class="speaker-card-title">{item.title}</div>
                        <hr class="speaker-card-line-info">
                        <div class="speaker-card-description">{item.description}</div>
                </section>
        )}
    </section>

</article>

