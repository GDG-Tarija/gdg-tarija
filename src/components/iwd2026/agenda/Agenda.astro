---
import "./agenda.css";
import agenda from "./agenda.json";
---
<article id="agenda" class="agenda-wrapper">
    <section class="agenda-container max-w-7xl">
        <h4 class="agenda-title">PROGRAMA</h4>
        <h1 class="agenda-large-title">Agenda del Evento</h1>
        <hr class="agenda-line">
        <section class="agenda-list">
        {agenda.map((item) =>
            <section class="agenda-card">
                    <div class="agenda-hour">{item.hour}</div>
                    <div class="agenda-description">{item.description}</div>
            </section>
        )}
        </section>
    </section>
</article>