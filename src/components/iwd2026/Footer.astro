---
import { Image } from 'astro:assets';
import WtmLogo from 'assets/images/iwd2026/wtm-logo-footer.png';

interface NavLink {
	label: string;
	href: string;
	target?: string;
	rel?: string;
}

const links: NavLink[] = [
	{ label: 'Inicio', href: '#inicio' },
	{ label: 'Lugar', href: '#lugar' },
	{ label: 'Speakers', href: '#speakers' },
	{ label: 'Sponsors', href: '#sponsors' },
	{ label: 'Agenda', href: '#agenda' },
	{ label: 'GDG Tarija', target: '_blank', rel: 'noopener noreferrer', href: 'https://gdgtarija.com/' },
];
---

<footer class='bg-black border-t border-t-[#1ce9b65b] pt-6 pb-5 '>
	<div class="max-w-7xl mx-auto items-center px-6 2xl:px-8">
		<div class='flex flex-col md:flex-row md:items-center justify-between flex-wrap gap-4'>
			<div class='flex items-center gap-1 md:gap-2'>
				<Image src={WtmLogo} alt='WTM Logo' width={48} height={48} class='shrink-0' />
				<div class="font-display">
					<p class='font-bold text-[#ffffffb7] text-sm md:text-base'>
						Women Techmakers
					</p>
					<p class='text-xs md:text-sm text-[#ffffff7d] mt-0.5'>
						Break the Pattern · 2026
					</p>
				</div>
			</div>
			<nav class='hidden md:flex flex-wrap items-center gap-y-1 gap-x-3 lg:gap-x-7' aria-label='Footer navigation'>
				{
					links.map(({ label, href, target, rel }) => (
						<a
							href={href}
							target={target}
							rel={rel}
							class='text-sm text-[#ffffff7d] font-display no-underline transition-colors duration-200 whitespace-nowrap hover:text-white'>
							{label}
						</a>
					))
				}
			</nav>
		</div>
		<div
			class='mt-5 pt-4 border-t border-t-[#ffffff29] text-[clamp(0.5rem,1vw,0.8rem)] text-[#ffffff7d] font-display'>
			<span>© 2026 Women Techmakers · Google Developers Group Tarija</span>
		</div>
	</div>
</footer>
