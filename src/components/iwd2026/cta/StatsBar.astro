---
interface Stat {
	value: string;
	label: string;
	short?: string;
}

const stats: Stat[] = [
	{ value: '100+', label: 'Asistentes', short: 'Asist.' },
	{ value: '4+', label: 'Speakers', short: 'Speak.' },
	{ value: '2', label: 'Workshops', short: 'Works.' },
	{ value: '1', label: 'Día Épico', short: 'Día' },
];
---

<div
	id='stats-bar'
	class='relative w-[70%] md:w-3/5 xl:w-[45%] 2xl:w-1/2 justify-items-end z-10 bg-black/45 animate-fade-iwd-up [animation-delay:1100ms]'>
	<div class="flex sm:max-w-100 md:max-w-120 lg:max-w-161 ps-3 lg:ps-0 justify-end">
		<div class='grid grid-cols-4'>
			{
				stats.map((s, i) => (
					<div
						class='flex flex-col items-start px-3 py-3 md:px-5 md:py-4 lg:py-5 lg:px-[1.4rem] 2xl:px-10 hover:bg-white/5 transition-colors duration-200'
						data-value={s.value}
						style={`animation-delay: ${1100 + i * 100}ms`}>
						<span class='stat-value text-iwd-accent font-black font-display leading-none text-[clamp(1.3rem,4vw,2rem)]'>
							{s.value}
						</span>
						<span class='text-white/45 text-xs font-semibold font-display tracking-[0.15em] uppercase mt-1'>
							<span class='md:hidden text-[8px]'>{s.short ?? s.label}</span>
							<span class='hidden md:inline'>{s.label}</span>
						</span>
					</div>
				))
			}
		</div>
	</div>
</div>

<script>
	const bar = document.getElementById('stats-bar');
	if (!bar) throw new Error('stats-bar not found');

	const observer = new IntersectionObserver(
		(entries) => {
			entries.forEach((entry) => {
				if (!entry.isIntersecting) return;
				observer.unobserve(entry.target);

				entry.target.querySelectorAll<HTMLElement>('[data-value]').forEach((item, idx) => {
					const raw = item.dataset.value ?? '';
					const num = parseInt(raw.replace(/\D/g, ''), 10);
					const suffix = raw.replace(/\d/g, '');
					const valueEl = item.querySelector<HTMLElement>('.stat-value');
					if (valueEl == null || Number.isNaN(num)) return;

					const duration = 1200;
					const startTime = performance.now() + idx * 120;
					const span = valueEl;

					function tick(now: number) {
						if (now < startTime) {
							requestAnimationFrame(tick);
							return;
						}
						const progress = Math.min((now - startTime) / duration, 1);
						const eased = 1 - Math.pow(1 - progress, 3);
						span.textContent = `${Math.round(eased * num)}${suffix}`;
						if (progress < 1) requestAnimationFrame(tick);
					}
					requestAnimationFrame(tick);
				});
			});
		},
		{ threshold: 0.4 },
	);

	observer.observe(bar);
</script>
