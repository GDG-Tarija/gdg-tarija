---
import { Image } from 'astro:assets';
import WtmLogo from 'assets/images/iwd2026/WTM_Logo.png';

interface NavLink {
	label: string;
	href: string;
}

const links: NavLink[] = [
	{ label: 'Inicio', href: '#inicio' },
	{ label: 'Speakers', href: '#speakers' },
	{ label: 'Agenda', href: '#agenda' },
	{ label: 'Sponsors', href: '#sponsors' },
	{ label: 'Lugar', href: '#lugar' },
];

const REGISTRO_URL =
	'https://docs.google.com/forms/d/e/1FAIpQLScX2P2GKiKEug2S3ZTBkm6DBv5rSipmqueMCZLljQbfRLrigw/viewform';
---

<header
	id='navbar'
	class='fixed top-0 left-0 right-0 z-50 flex items-center justify-between px-8 py-4 transition-all duration-500 animate-fade-iwd-in'>
	<a
		href='https://www.technovation.org/women-techmakers/'
		target='_blank'
		rel='noopener noreferrer'
		class='flex items-center gap-2 group'
		aria-label='WTM Tarija Home'>
		<Image
			src={WtmLogo}
			alt='WTM Logo'
			width='220'
			class='h-10 object-left object-contain group-hover:animate-pulse transition-all duration-300'
		/>
	</a>
	<!-- Desktop nav -->
	<nav class='hidden md:flex items-center gap-4 lg:gap-8 ml-2' aria-label='Navegación principal'>
		{
			links.map(({ label, href }) => (
				<a
					href={href}
					class='text-white/70 hover:text-white text-xs lg:text-sm font-medium font-display tracking-widest uppercase transition-colors duration-200 relative after:absolute after:bottom-0 after:left-0 after:w-0 after:h-px after:bg-iwd-accent after:transition-all hover:after:w-full'>
					{label}
				</a>
			))
		}
		<a
			href={REGISTRO_URL}
			target='_blank'
			rel='noopener noreferrer'
			class='ml-2 bg-iwd-accent text-iwd-blue-primary font-display font-black px-5 py-2 text-xs tracking-[0.2em] uppercase rounded hover:bg-iwd-accent-hover hover:scale-105 active:scale-95 transition-all duration-200 shadow-lg shadow-iwd-accent/20'>
			Regístrate
		</a>
	</nav>
	<!-- Mobile hamburger -->
	<button
		id='mobile-menu-btn'
		class='md:hidden flex flex-col gap-1.5 p-2 group cursor-pointer'
		aria-label='Abrir menú'
		aria-expanded='false'
		aria-controls="mobile-menu">
		<span
			class='w-6 h-0.5 bg-white block transition-all duration-300 opacity-0 group-aria-expanded:opacity-100 group-aria-expanded:rotate-45 group-aria-expanded:translate-y-2.5'
		></span>
		<span class='w-6 h-1.5 bg-white block transition-all duration-300 group-aria-expanded:opacity-0'></span>
		<span
			class='w-6 h-0.5 bg-white block transition-all duration-300 opacity-0 group-aria-expanded:opacity-100 group-aria-expanded:-rotate-45 group-aria-expanded:-translate-y-2.5'
		></span>
	</button>
</header>
<!-- Mobile drawer -->
<div
	id='mobile-menu'
	role="dialog"
	aria-modal="true"
	aria-label="Menú de navegación"
	aria-hidden="true"
	class='fixed inset-0 z-40 bg-iwd-navy/95 backdrop-blur-sm flex flex-col items-center justify-center gap-8 translate-x-full transition-transform duration-300 md:hidden'>
	{
		links.map(({ label, href }) => (
			<a
				href={href}
				class='text-white text-xl font-black font-display tracking-widest uppercase hover:text-iwd-accent transition-colors'>
				{label}
			</a>
		))
	}
	<a
		href={REGISTRO_URL}
		target='_blank'
		rel='noopener noreferrer'
		class='mt-4 bg-iwd-accent text-iwd-blue-primary font-display font-black px-8 py-3 text-sm tracking-[0.2em] uppercase rounded'>
		Regístrate
	</a>
</div>

<script>
	const btn    = document.getElementById('mobile-menu-btn') as HTMLButtonElement;
	const menu   = document.getElementById('mobile-menu') as HTMLElement;
	const header = document.getElementById('navbar') as HTMLElement;

	function toggleMenu(open: boolean) {
		menu.classList.toggle('translate-x-full', !open);
		btn.setAttribute('aria-expanded', String(open));
		menu.setAttribute('aria-hidden', String(!open));
		document.body.style.overflow = open ? 'hidden' : '';
	}

	btn.addEventListener('click', () => {
		toggleMenu(btn.getAttribute('aria-expanded') === 'false');
	});

	menu.querySelectorAll('a').forEach((link) => {
		link.addEventListener('click', () => toggleMenu(false));
	});

	window.addEventListener(
		'scroll',
		() => header.classList.toggle('navbar-scrolled', window.scrollY > 20),
		{ passive: true },
	);
</script>

<style>
	.navbar-scrolled {
		background: rgba(3, 52, 171, 0.85);
		backdrop-filter: blur(12px);
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
	}
</style>
