---
// Fondo del hero: columnas de código real del ecosistema Google que suben y bajan.
// Se renderizan dos capas idénticas: una gris tenue siempre visible y otra con resaltado de sintaxis
// en colores Google que solo se ve dentro de la "linterna" que sigue al cursor.

const snippets = [
  `import 'package:flutter/material.dart';

void main() => runApp(const GdgTarija());

class GdgTarija extends StatelessWidget {
  const GdgTarija({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(home: Comunidad());
  }
}`,
  `@Composable
fun Evento(nombre: String) {
  Column(modifier = Modifier.padding(16.dp)) {
    Text(text = "Hola, $nombre")
    Button(onClick = { unirse() }) {
      Text("Únete")
    }
  }
}`,
  `import { initializeApp } from 'firebase/app';
import { getFirestore } from 'firebase/firestore';

const app = initializeApp(config);
const db = getFirestore(app);

await addDoc(collection(db, 'miembros'), {
  ciudad: 'Tarija',
  rol: 'developer',
});`,
  `import google.generativeai as genai

model = genai.GenerativeModel('gemini-1.5-flash')
res = model.generate_content('Hola, GDG Tarija')

# 2013: primer meetup
print(res.text)`,
  `package main

import "fmt"

func main() {
  ciudad := "Tarija"
  for i := 0; i < 3; i++ {
    fmt.Println("Hola,", ciudad)
  }
}`,
  `const evento = {
  nombre: 'DevFest',
  sede: 'Tarija, Bolivia',
  cupos: 200,
};

export async function registrar(dev) {
  return fetch('/api/registro', {
    method: 'POST',
    body: JSON.stringify(dev),
  });
}`,
];

const KEYWORDS = new Set([
  'import',
  'from',
  'const',
  'val',
  'fun',
  'func',
  'package',
  'class',
  'extends',
  'return',
  'await',
  'async',
  'void',
  'for',
  'export',
  'function',
  'super',
  'as',
  'print',
]);

const escapeHtml = (text: string) =>
  text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

// Resaltador mínimo en build: suficiente para que el color marque la estructura del código (The Signal Rule)
const TOKEN =
  /(\/\/.*$|#.*$)|('[^']*'|"[^"]*"|`[^`]*`)|(@\w+)|\b(\d+(?:\.\d+)?)\b|\b([A-Za-z_]\w*)\b(?=\s*\()|\b([A-Za-z_]\w*)\b/g;

function highlight(line: string): string {
  let html = '';
  let last = 0;
  for (const match of line.matchAll(TOKEN)) {
    const [text, comment, str, annotation, num, call, word] = match;
    html += escapeHtml(line.slice(last, match.index));
    last = (match.index ?? 0) + text.length;
    const safe = escapeHtml(text);
    if (comment) html += `<span class="tk-com">${safe}</span>`;
    else if (str) html += `<span class="tk-str">${safe}</span>`;
    else if (annotation) html += `<span class="tk-ann">${safe}</span>`;
    else if (num) html += `<span class="tk-num">${safe}</span>`;
    else if (call && !KEYWORDS.has(call)) html += `<span class="tk-fn">${safe}</span>`;
    else if (KEYWORDS.has(call ?? word ?? '')) html += `<span class="tk-kw">${safe}</span>`;
    else html += safe;
  }
  return html + escapeHtml(line.slice(last));
}

// Cada columna encadena snippets distintos y se duplica para que el loop vertical no tenga cortes
const COLUMN_COUNT = 7;
const columns = Array.from({ length: COLUMN_COUNT }, (_, col) => {
  const picked = [0, 1, 2].map((offset) => snippets[(col * 2 + offset) % snippets.length]);
  const html = picked
    .map((snippet) => snippet.split('\n').map(highlight).join('\n'))
    .join('\n\n\n');
  return {
    html: `${html}\n\n\n${html}\n\n\n`,
    direction: col % 2 === 0 ? 'up' : 'down',
    duration: 70 + ((col * 17) % 40),
    parallax: col % 2 === 0 ? -1 : 1,
  };
});
---

<div class="code-field" aria-hidden="true" data-code-field>
  {
    ['base', 'lit'].map((layer) => (
      <div class={`code-layer code-layer--${layer}`}>
        {columns.map((column) => (
          <div class="code-column" data-parallax={column.parallax}>
            <pre
              class={`code-track code-track--${column.direction}`}
              style={`--duration: ${column.duration}s;`}
              set:html={column.html}
            />
          </div>
        ))}
      </div>
    ))
  }
</div>

<style>
  .code-field {
    --x: 70%;
    --y: 40%;
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    /* Se desvanece arriba y abajo, y casi desaparece detrás del texto para no competir con la lectura */
    mask-image:
      linear-gradient(to bottom, transparent 0%, #000 18%, #000 78%, transparent 100%),
      linear-gradient(to bottom, rgb(0 0 0 / 0.25), rgb(0 0 0 / 0.25));
    mask-composite: intersect;
    opacity: 0;
    transition: opacity 1.2s ease-out 0.6s;
  }

  .code-field.is-ready {
    opacity: 1;
  }

  /* En escritorio el texto vive a la izquierda: el código se apaga ahí y brilla detrás de la foto */
  @media (min-width: 1024px) {
    .code-field {
      mask-image:
        linear-gradient(to bottom, transparent 0%, #000 18%, #000 78%, transparent 100%),
        radial-gradient(ellipse 42% 55% at 27% 50%, rgb(0 0 0 / 0.15) 40%, #000 100%);
    }
  }

  .code-layer {
    position: absolute;
    inset: -10% 0;
    display: flex;
    justify-content: center;
    gap: 3rem;
    font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;
    font-size: 0.6875rem;
    line-height: 1.9;
    white-space: pre;
  }

  .code-layer--base {
    color: var(--color-gray-400);
    opacity: 0.32;
  }

  @media (min-width: 1024px) {
    .code-layer {
      font-size: 0.8125rem;
    }
  }

  .code-layer--base :global(span) {
    color: inherit;
  }

  /* La capa iluminada solo existe dentro del círculo de la linterna */
  .code-layer--lit {
    color: var(--color-gray-500);
    mask-image: radial-gradient(
      circle 15rem at var(--x) var(--y),
      #000 0%,
      rgb(0 0 0 / 0.55) 45%,
      transparent 75%
    );
  }

  .code-layer--lit :global(.tk-kw) {
    color: var(--color-gdg-blue);
    font-weight: 600;
  }
  .code-layer--lit :global(.tk-str) {
    color: var(--color-gdg-green);
  }
  .code-layer--lit :global(.tk-num),
  .code-layer--lit :global(.tk-ann) {
    color: var(--color-gdg-red);
  }
  .code-layer--lit :global(.tk-fn) {
    color: var(--color-gdg-yellow);
    font-weight: 600;
  }
  .code-layer--lit :global(.tk-com) {
    color: var(--color-gray-400);
    font-style: italic;
  }

  .code-column {
    flex: 0 0 auto;
    will-change: transform;
  }

  .code-track {
    margin: 0;
    font: inherit;
  }

  @media (prefers-reduced-motion: no-preference) {
    .code-track--up {
      animation: code-up var(--duration) linear infinite;
    }

    .code-track--down {
      animation: code-down var(--duration) linear infinite;
    }

    .code-field.is-paused .code-track {
      animation-play-state: paused;
    }
  }

  @keyframes code-up {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(-50%);
    }
  }

  @keyframes code-down {
    from {
      transform: translateY(-50%);
    }
    to {
      transform: translateY(0);
    }
  }
</style>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-code-field]').forEach((field) => {
    const hero = field.closest('section');
    if (!hero) return;
    requestAnimationFrame(() => field.classList.add('is-ready'));

    let pointerActive = false;
    let visible = true;
    let frame = 0;
    let target = { x: 0.7, y: 0.4 };
    const current = { x: 0.7, y: 0.4 };
    const columns = Array.from(field.querySelectorAll<HTMLElement>('.code-column'));

    // La linterna persigue al cursor con inercia; sin cursor (móvil o inactivo) recorre el fondo sola
    const tick = (time: number) => {
      if (!pointerActive && !reduceMotion) {
        target = {
          x: 0.5 + 0.38 * Math.sin(time / 5200),
          y: 0.45 + 0.3 * Math.sin(time / 3700 + 1.3),
        };
      }
      current.x += (target.x - current.x) * 0.08;
      current.y += (target.y - current.y) * 0.08;
      field.style.setProperty('--x', `${(current.x * 100).toFixed(2)}%`);
      field.style.setProperty('--y', `${(current.y * 100).toFixed(2)}%`);
      if (visible) frame = requestAnimationFrame(tick);
    };

    const start = () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(tick);
    };

    hero.addEventListener('pointermove', (event) => {
      if (event.pointerType !== 'mouse') return;
      const rect = field.getBoundingClientRect();
      pointerActive = true;
      target = {
        x: (event.clientX - rect.left) / rect.width,
        y: (event.clientY - rect.top) / rect.height,
      };
    });
    hero.addEventListener('pointerleave', () => (pointerActive = false));

    // Fuera de pantalla no se anima nada: ni el loop de columnas ni la linterna
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      field.classList.toggle('is-paused', !visible);
      if (visible) start();
    }).observe(hero);

    // Parallax al hacer scroll: columnas pares e impares se separan a velocidades opuestas
    if (!reduceMotion) {
      let ticking = false;
      window.addEventListener(
        'scroll',
        () => {
          if (ticking || !visible) return;
          ticking = true;
          requestAnimationFrame(() => {
            const offset = window.scrollY * 0.12;
            columns.forEach((column) => {
              column.style.transform = `translate3d(0, ${Number(column.dataset.parallax) * offset}px, 0)`;
            });
            ticking = false;
          });
        },
        { passive: true },
      );
    }

    start();
  });
</script>
