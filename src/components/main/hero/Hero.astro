---
import { Image } from 'astro:assets';
import Button from '../../common/Button.astro';
import CodeField from './CodeField.astro';
import FotoGrupal from '../../../assets/images/photos-comunity/io-extended-2024-grupal.jpg';

const JOIN_URL = 'https://gdg.community.dev/gdg-tarija/';
const EVENTS_URL = 'https://eventos.gdgtarija.com';
---

<section
  id="inicio"
  class="relative isolate overflow-hidden bg-background"
  aria-labelledby="hero-title"
>
  <CodeField />

  <div
    class="relative z-10 mx-auto grid max-w-6xl items-center gap-10 px-4 pt-28 pb-16 md:px-8 md:pt-32 lg:grid-cols-12 lg:gap-12 lg:pb-24"
  >
    <div class="hero-enter lg:col-span-6">
      <h1
        id="hero-title"
        class="text-[clamp(2.125rem,9.5vw,2.5rem)] leading-[1.1] font-medium tracking-[-0.02em] text-balance text-gray-900 sm:text-5xl xl:text-[3.25rem]"
      >
        La comunidad de desarrolladores de Tarija
      </h1>
      <p class="mt-5 max-w-md text-base leading-relaxed text-pretty text-gray-600 md:text-lg">
        Somos el capítulo local de Google Developer Groups y organizamos eventos para developers
        desde 2013.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
        <Button href={JOIN_URL} target="_blank" rel="noopener noreferrer" iconPosition="right">
          Únete a la comunidad
          <i slot="icon" class="fa-solid fa-arrow-right text-xs" aria-hidden="true"></i>
        </Button>
        <Button href={EVENTS_URL} target="_blank" rel="noopener noreferrer" variant="outline">
          Ver eventos
        </Button>
      </div>
    </div>

    <div class="hero-enter lg:col-span-6" style="--delay: 0.1s;">
      <Image
        src={FotoGrupal}
        alt="Foto grupal de los asistentes a Google I/O Extended Tarija 2024"
        widths={[480, 720, 960, 1280]}
        sizes="(min-width: 1152px) 540px, (min-width: 1024px) 46vw, 92vw"
        class="aspect-4/3 w-full rounded-xl object-cover object-[50%_45%]"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>
</section>

<style>
  /* Entrada única y discreta: un fundido corto, sin máscaras ni zoom (la animación no debe robar la escena) */
  @media (prefers-reduced-motion: no-preference) {
    .hero-enter {
      animation: hero-enter 0.6s cubic-bezier(0.25, 1, 0.5, 1) both;
      animation-delay: var(--delay, 0s);
    }
  }

  @keyframes hero-enter {
    from {
      opacity: 0;
      transform: translateY(0.5rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
