---
import infoAbout from "./infoAbout.json";
import Slide from "./Slide.astro";
import ButtonsNavigate from "./ButtonsNavigate.astro";
import { ChevronLeft, ChevronRight } from "lucide-astro";
---

<!-- About Section -->
<section
  id="about"
  class="w-full bg-neutral-800 text-zinc-100 py-16 md:py-20 animate-fade-up animate-duration-[1500ms] animate-ease-in animate-fill-forwards"
>
  <div
    id="default-carousel"
    class="relative flex flex-col items-center max-w-6xl mx-auto px-4"
    data-carousel="static"
  >
    <!-- Carousel wrapper -->
    <div
      class="overflow-hidden w-full relative min-h-[380px] sm:min-h-[360px] md:min-h-[340px] lg:min-h-[320px] rounded-xl shadow-2xl bg-neutral-900/50 backdrop-blur-sm border border-neutral-700/50"
      id="carousel-wrapper"
    >
      <!-- Slider items -->
      {infoAbout.map((info) => <Slide {...info} />)}

      <!-- Slider indicators -->
      <div
        class="flex absolute bottom-4 left-1/2 z-30 space-x-2 -translate-x-1/2"
      >
        {infoAbout.map((info) => <ButtonsNavigate {...info} />)}
      </div>

      <!-- Slider controls -->
      <button
        type="button"
        class="absolute top-1/2 left-2 md:left-4 z-30 -translate-y-1/2 w-10 h-10 bg-black/30 backdrop-blur-sm hover:bg-black/50 rounded-full flex items-center justify-center cursor-pointer group focus:outline-none focus:ring-2 focus:ring-white/50 transition-all duration-200 hover:scale-110 active:scale-95"
        data-carousel-prev
        aria-label="Slide anterior"
      >
        <ChevronLeft
          class="w-5 h-5 text-white/90 group-hover:text-white transition-colors"
        />
      </button>
      <button
        type="button"
        class="absolute top-1/2 right-2 md:right-4 z-30 -translate-y-1/2 w-10 h-10 bg-black/30 backdrop-blur-sm hover:bg-black/50 rounded-full flex items-center justify-center cursor-pointer group focus:outline-none focus:ring-2 focus:ring-white/50 transition-all duration-200 hover:scale-110 active:scale-95"
        data-carousel-next
        aria-label="Slide siguiente"
      >
        <ChevronRight
          class="w-5 h-5 text-white/90 group-hover:text-white transition-colors"
        />
      </button>
    </div>
  </div>
</section>

<script>
  if (typeof window !== "undefined") {
    document.addEventListener("DOMContentLoaded", () => {
      const carousel = document.getElementById("default-carousel");
      if (!carousel) return;

      const items = Array.from(
        carousel.querySelectorAll("[data-carousel-item]")
      );
      const prevButton = carousel.querySelector("[data-carousel-prev]");
      const nextButton = carousel.querySelector("[data-carousel-next]");
      const indicators = Array.from(
        carousel.querySelectorAll("[data-carousel-slide-to]")
      );

      let currentIndex = 0;
      let direction: "left" | "right" = "right";

      const showSlide = (index: number, slideDirection?: "left" | "right") => {
        // Asegurar que el índice esté en rango
        if (index < 0) index = items.length - 1;
        if (index >= items.length) index = 0;

        const previousIndex = currentIndex;
        currentIndex = index;

        // Determinar dirección si no se especifica
        if (!slideDirection) {
          if (
            index > previousIndex ||
            (index === 0 && previousIndex === items.length - 1)
          ) {
            direction = "right";
          } else {
            direction = "left";
          }
        } else {
          direction = slideDirection;
        }

        // Ocultar todos los slides y preparar animación
        items.forEach((item, i) => {
          const element = item as HTMLElement;

          if (i === currentIndex) {
            // Slide entrante
            element.classList.remove("hidden");
            void element.offsetHeight; // Forzar reflow

            // Posicionar fuera de la vista según dirección
            if (direction === "right") {
              element.style.transform = "translateX(100%)";
            } else {
              element.style.transform = "translateX(-100%)";
            }
            element.style.opacity = "0";

            // Animar hacia el centro con transición suave
            requestAnimationFrame(() => {
              element.style.transition =
                "opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1), transform 0.7s cubic-bezier(0.16, 1, 0.3, 1)";
              element.style.opacity = "1";
              element.style.transform = "translateX(0)";
            });
          } else if (i === previousIndex) {
            // Slide saliente
            const exitDirection = direction === "right" ? "-100%" : "100%";
            element.style.transition =
              "opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1), transform 0.7s cubic-bezier(0.16, 1, 0.3, 1)";
            element.style.opacity = "0";
            element.style.transform = `translateX(${exitDirection})`;

            setTimeout(() => {
              element.classList.add("hidden");
            }, 700);
          } else {
            // Otros slides - mantener ocultos
            element.style.opacity = "0";
            element.style.transform = "translateX(0)";
            element.classList.add("hidden");
          }
        });

        // Actualizar indicadores
        indicators.forEach((indicator, i) => {
          const btn = indicator as HTMLElement;
          if (i === currentIndex) {
            indicator.setAttribute("aria-current", "true");
            btn.classList.remove("bg-white/50", "dark:bg-gray-800/50");
            btn.classList.add("bg-white", "dark:bg-gray-800");
          } else {
            indicator.setAttribute("aria-current", "false");
            btn.classList.remove("bg-white", "dark:bg-gray-800");
            btn.classList.add("bg-white/50", "dark:bg-gray-800/50");
          }
        });
      };

      const nextSlide = () => {
        showSlide(currentIndex + 1, "right");
      };

      const prevSlide = () => {
        showSlide(currentIndex - 1, "left");
      };

      const goToSlide = (index: number) => {
        // Determinar dirección basada en el índice
        const slideDirection = index > currentIndex ? "right" : "left";
        showSlide(index, slideDirection);
      };

      // Event listeners
      prevButton?.addEventListener("click", prevSlide);
      nextButton?.addEventListener("click", nextSlide);

      indicators.forEach((indicator, index) => {
        indicator.addEventListener("click", () => goToSlide(index));
      });

      // Inicializar - mostrar el primer slide
      showSlide(0);
    });
  }
</script>
