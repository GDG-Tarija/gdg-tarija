---
const { titulo, descripcion } = Astro.props;
---

<div
  class="hidden px-6 sm:px-12 md:px-16 lg:px-20 py-8 md:py-12 pb-20 md:pb-24 absolute inset-0 w-full flex flex-col justify-center"
  data-carousel-item
>
  <h2
    class="text-2xl md:text-3xl lg:text-4xl font-bold text-center text-white mb-4 md:mb-6"
  >
    {titulo}
  </h2>
  <p
    class="text-center text-sm sm:text-base md:text-lg leading-relaxed text-zinc-200 max-w-4xl mx-auto"
  >
    {descripcion}
  </p>
</div>

<style>
  [data-carousel-item] {
    opacity: 0;
    transform: translateX(0);
    pointer-events: none;
  }

  [data-carousel-item]:not(.hidden) {
    pointer-events: auto;
  }
</style>
