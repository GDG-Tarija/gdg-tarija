---
import { Image } from 'astro:assets';
const { medio, contacto, logo } = Astro.props;

import ImgGmail from '../../../assets/images/gmail.png';

const imagenes = {
  gmail: ImgGmail,
};
---

<div class="flex items-center">
  <Image class="h-7 w-auto sm:h-14" src={imagenes[logo]} alt={medio} />
  <span class="self-center text-l sm:text-lg"> {contacto} </span>
</div>
