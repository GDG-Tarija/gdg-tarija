---
import Section from '../../common/Section.astro';
import Button from '../../common/Button.astro';
import contactos from './contact.json';

const JOIN_URL = 'https://gdg.community.dev/gdg-tarija/';
const email = contactos.find((c) => c.medio === 'gmail')?.contacto;
---

<Section id="contact" tone="surface" labelledby="contact-title" flushTop>
  <div
    class="relative isolate overflow-hidden rounded-2xl bg-gdg-blue-deep px-6 py-14 text-center text-white md:px-12 md:py-20"
  >
    <!-- Los chevrons de GDG enmarcan el contenido a ambos lados: el bloque se lee como "< Únete >" y no deja un lado vacío -->
    {
      [
        {
          path: 'M62 14 14 60l48 46',
          side: 'left-0 -translate-x-[35%] md:translate-x-0 md:left-8 lg:left-14',
        },
        {
          path: 'M18 14l48 46-48 46',
          side: 'right-0 translate-x-[35%] md:translate-x-0 md:right-8 lg:right-14',
        },
      ].map((chevron) => (
        <svg
          class={`pointer-events-none absolute top-1/2 -z-10 h-40 w-auto -translate-y-1/2 text-white/[0.12] md:h-64 ${chevron.side}`}
          viewBox="0 0 80 120"
          fill="none"
          aria-hidden="true"
        >
          <path
            d={chevron.path}
            stroke="currentColor"
            stroke-width="20"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      ))
    }

    <div class="mx-auto max-w-2xl">
      <h2
        id="contact-title"
        class="text-4xl leading-[1.05] font-bold tracking-[-0.03em] text-balance md:text-5xl lg:text-6xl"
      >
        Únete a la comunidad
      </h2>
      <p class="mx-auto mt-5 max-w-md text-lg leading-relaxed text-pretty text-white/90">
        Entérate de los próximos eventos y conecta con otros developers de Tarija.
      </p>
      <div class="mt-9 flex flex-col items-center gap-5 sm:flex-row sm:justify-center sm:gap-8">
        <Button
          href={JOIN_URL}
          target="_blank"
          rel="noopener noreferrer"
          variant="inverse"
          iconPosition="right"
        >
          Únete a la comunidad
          <i slot="icon" class="fa-solid fa-arrow-right text-base" aria-hidden="true"></i>
        </Button>
        {
          email && (
            <a
              href={`mailto:${email}`}
              class="-my-2.5 inline-flex items-center gap-2.5 rounded-sm py-2.5 font-medium text-white/90 underline-offset-4 transition-colors duration-200 hover:text-white hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
            >
              <i class="fa-regular fa-envelope" aria-hidden="true" />
              {email}
            </a>
          )
        }
      </div>
    </div>
  </div>
</Section>
