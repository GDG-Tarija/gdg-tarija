---
import Section from '../../common/Section.astro';
import Button from '../../common/Button.astro';
import contactos from './contact.json';

const JOIN_URL = 'https://gdg.community.dev/gdg-tarija/';
const email = contactos.find((c) => c.medio === 'gmail')?.contacto;
---

<Section id="contact" tone="surface" labelledby="contact-title" flushTop>
  <div
    class="relative isolate overflow-hidden rounded-xl bg-gdg-blue-deep px-6 py-12 text-center text-white md:px-12 md:py-14"
  >
    <!-- Los chevrons de GDG enmarcan el contenido a ambos lados ("< Únete >"): textura de marca quieta, sin animación -->
    {
      [
        {
          path: 'M62 14 14 60l48 46',
          side: 'left-0 -translate-x-[40%] md:translate-x-0 md:left-8 lg:left-12',
        },
        {
          path: 'M18 14l48 46-48 46',
          side: 'right-0 translate-x-[40%] md:translate-x-0 md:right-8 lg:right-12',
        },
      ].map((chevron) => (
        <div
          class={`pointer-events-none absolute inset-y-0 -z-10 my-auto h-28 md:h-40 ${chevron.side}`}
          aria-hidden="true"
        >
          <svg class="h-full w-auto text-white/[0.1]" viewBox="0 0 80 120" fill="none">
            <path
              d={chevron.path}
              stroke="currentColor"
              stroke-width="16"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </div>
      ))
    }

    <div class="mx-auto max-w-2xl" data-reveal>
      <h2
        id="contact-title"
        class="text-3xl leading-tight font-medium tracking-[-0.01em] text-balance md:text-4xl"
      >
        Únete a la comunidad
      </h2>
      <p
        class="mx-auto mt-3 max-w-md text-base leading-relaxed text-pretty text-white/90 md:text-lg"
      >
        Entérate de los próximos eventos y conecta con otros developers de Tarija.
      </p>
      <div class="mt-7 flex flex-col items-center gap-4 sm:flex-row sm:justify-center sm:gap-6">
        <Button
          href={JOIN_URL}
          target="_blank"
          rel="noopener noreferrer"
          variant="inverse"
          iconPosition="right"
        >
          Únete a la comunidad
          <i slot="icon" class="fa-solid fa-arrow-right text-xs" aria-hidden="true"></i>
        </Button>
        {
          email && (
            <a
              href={`mailto:${email}`}
              class="-my-2.5 inline-flex items-center gap-2 rounded-sm py-2.5 text-sm font-medium text-white/90 underline-offset-4 transition-colors duration-200 hover:text-white hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
            >
              <i class="fa-regular fa-envelope" aria-hidden="true" />
              {email}
            </a>
          )
        }
      </div>
    </div>
  </div>
</Section>
