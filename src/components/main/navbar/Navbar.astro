---
import MenuList from '../navbar/menuList.json';
import Button from '../../common/Button.astro';

const JOIN_URL = 'https://gdg.community.dev/gdg-tarija/';
---

<!-- Barra plana de borde a borde, como el header de las páginas de Google: el contenido manda, no la navegación -->
<header
  id="site-nav"
  class="fixed inset-x-0 top-[var(--banner-offset,0px)] z-50 border-b border-transparent bg-background/90 backdrop-blur-md transition-[background-color,border-color] duration-200 data-[scrolled=true]:border-gray-200 data-[scrolled=true]:bg-white/95"
>
  <nav
    class="relative mx-auto flex h-16 max-w-6xl items-center justify-between px-4 md:px-8"
    aria-label="Principal"
  >
    <a href="/" aria-label="GDG Tarija, inicio" class="flex h-full items-center">
      <img
        class="h-8 w-auto md:hidden"
        src="https://res.cloudinary.com/dopkch3x9/image/upload/v1769174223/logoGDG_Tarija_nox4y2.svg"
        alt=""
      />
      <img
        class="hidden h-9 w-auto md:block"
        src="https://res.cloudinary.com/dopkch3x9/image/upload/v1752286109/gdg_tarija_logo_t3xzpo.svg"
        alt=""
      />
    </a>

    <!-- Menú de escritorio -->
    <div class="hidden h-full items-center gap-8 md:flex">
      <ul class="flex h-full items-center gap-7 text-sm font-medium text-gray-600">
        {
          MenuList.map((menu) => (
            <li class="h-full">
              <a
                href={menu.href}
                data-spy-link={menu.href.replace('/#', '')}
                class="relative flex h-full items-center transition-colors duration-150 after:absolute after:inset-x-0 after:bottom-0 after:h-0.5 after:origin-center after:scale-x-0 after:bg-gdg-blue-deep after:transition-transform after:duration-200 hover:text-gray-900 aria-[current=true]:text-gray-900 aria-[current=true]:after:scale-x-100"
              >
                {menu.title}
              </a>
            </li>
          ))
        }
      </ul>
      <Button href={JOIN_URL} target="_blank" rel="noopener noreferrer" size="sm">Únete</Button>
    </div>

    <button
      id="menu-button"
      type="button"
      class="-mr-2 flex size-11 cursor-pointer items-center justify-center rounded-lg text-lg text-gray-700 transition-colors duration-150 hover:bg-gray-100 focus-visible:outline-2 focus-visible:outline-gdg-blue md:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Abrir menú"
    >
      <i class="fa-solid fa-bars" aria-hidden="true"></i>
    </button>
  </nav>

  <!-- Menú móvil: se despliega como una continuación de la barra, sin tarjeta flotante -->
  <div id="mobile-menu" class="hidden border-t border-gray-200 bg-white md:hidden">
    <ul class="mx-auto flex max-w-6xl flex-col px-4 py-2">
      {
        MenuList.map((menu) => (
          <li class="border-b border-gray-100">
            <a
              href={menu.href}
              class="block py-3.5 text-base font-medium text-gray-900 transition-colors duration-150 hover:text-gdg-blue-deep"
            >
              {menu.title}
            </a>
          </li>
        ))
      }
      <li class="py-4">
        <Button href={JOIN_URL} target="_blank" rel="noopener noreferrer" class="w-full">
          Únete a la comunidad
        </Button>
      </li>
    </ul>
  </div>
</header>

<script>
  const button = document.getElementById('menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  const icon = button?.querySelector('i');

  const setMenuOpen = (open: boolean) => {
    if (!button || !mobileMenu) return;
    mobileMenu.classList.toggle('hidden', !open);
    button.setAttribute('aria-expanded', String(open));
    button.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    icon?.classList.toggle('fa-bars', !open);
    icon?.classList.toggle('fa-xmark', open);
  };

  button?.addEventListener('click', () => {
    setMenuOpen(button.getAttribute('aria-expanded') !== 'true');
  });

  // Al elegir una sección o hacer scroll, el menú se cierra para no tapar el contenido
  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setMenuOpen(false));
  });
  window.addEventListener('scroll', () => setMenuOpen(false), { passive: true });

  // Con scroll la barra se vuelve blanca y gana un borde: se separa del contenido que pasa por debajo
  const nav = document.getElementById('site-nav');
  const updateScrolled = () => nav?.setAttribute('data-scrolled', String(window.scrollY > 12));
  updateScrolled();
  window.addEventListener('scroll', updateScrolled, { passive: true });

  // Scrollspy: el enlace de la sección visible queda subrayado, como las pestañas de Google
  const spyLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-spy-link]'));
  const sections = spyLinks
    .map((link) => document.getElementById(link.dataset.spyLink ?? ''))
    .filter((section): section is HTMLElement => section !== null);
  const markActive = (id: string | null) =>
    spyLinks.forEach((link) =>
      link.setAttribute('aria-current', String(link.dataset.spyLink === id)),
    );

  if (sections.length) {
    const spy = new IntersectionObserver(
      (entries) => {
        const visible = entries.filter((entry) => entry.isIntersecting);
        if (visible.length) markActive(visible[0].target.id);
        else if (window.scrollY < sections[0].offsetTop - window.innerHeight / 2) markActive(null);
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    sections.forEach((section) => spy.observe(section));
  }
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') setMenuOpen(false);
  });
</script>
