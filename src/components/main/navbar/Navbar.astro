---
import { Menu, X } from "lucide-astro";
import MenuList from "../navbar/menuList.json";
---

<header
  class="bg-white/95 backdrop-blur-sm top-0 start-0 border-b border-gray-200 w-full fixed z-10 shadow-sm"
>
  <nav class="flex flex-wrap justify-between items-center py-4 px-6 md:px-10">
    <div class="h-12 flex items-center">
      <a href="/" aria-label="Home">
        <img
          class="h-10 w-auto md:hidden"
          src="https://res.cloudinary.com/dopkch3x9/image/upload/v1769174223/logoGDG_Tarija_nox4y2.svg"
          alt="GDG Tarija Logo Mobile"
        />
        <img
          class="h-10 w-auto hidden md:flex lg:h-12"
          src="https://res.cloudinary.com/dopkch3x9/image/upload/v1752286109/gdg_tarija_logo_t3xzpo.svg"
          alt="GDG Tarija Logo Desktop"
        />
      </a>
    </div>
    <button
      id="menu-button"
      class="text-gray-700 hover:text-azul-GDG md:hidden cursor-pointer p-2 rounded-lg hover:bg-gray-100 transition-all duration-200"
    >
      <Menu class="h-6 w-6" />
    </button>
    <!-- Menú desktop -->
    <div
      id="menu-open"
      class="items-center text-center w-full hidden md:flex md:w-auto animate-fade-down animate-duration-300"
    >
      <ul
        class="font-medium text-sm lg:text-lg text-gray-700 bg-white/95 backdrop-blur-sm flex flex-col pt-6 md:flex-row md:pt-0 gap-6 md:gap-x-8 lg:gap-x-10 md:bg-transparent md:backdrop-blur-none rounded-lg md:rounded-none shadow-lg md:shadow-none mt-2 md:mt-0"
      >
        {
          MenuList.map((menu) => (
            <li>
              <a
                href={menu.href}
                class="block px-4 py-3 md:px-0 md:py-0 hover:text-azul-GDG hover:bg-gray-50 md:hover:bg-transparent transition-all duration-200 rounded-md"
              >
                {menu.title}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <!-- Menú móvil mejorado -->
    <div
      id="mobile-menu"
      class="w-full hidden md:hidden bg-gradient-to-b from-white to-gray-50/50 backdrop-blur-md border-t border-gray-200 shadow-2xl"
    >
      <nav class="px-4 py-6">
        <ul class="flex flex-col space-y-1">
          {
            MenuList.map((menu, index) => (
              <li>
                <a
                  href={menu.href}
                  class="group block px-5 py-4 text-base font-semibold text-gray-700 hover:text-azul-GDG bg-white/80 hover:bg-gradient-to-r hover:from-azul-GDG/10 hover:to-transparent rounded-xl transition-all duration-300 transform hover:translate-x-2 hover:shadow-lg border-l-4 border-transparent hover:border-azul-GDG"
                >
                  <span class="flex items-center justify-between">
                    <span>{menu.title}</span>
                    <svg
                      class="w-5 h-5 text-azul-GDG opacity-0 group-hover:opacity-100 transition-all duration-300 transform group-hover:translate-x-1"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M9 5l7 7-7 7"
                      />
                    </svg>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </nav>
</header>

<script>
  const button = document.querySelector("#menu-button");
  const menuOpen = document.querySelector("#menu-open");
  const mobileMenu = document.querySelector("#mobile-menu");
  const menuIcon = button.querySelector("svg");

  const toggleMobileMenu = () => {
    const isHidden = mobileMenu.classList.contains("hidden");

    if (isHidden) {
      mobileMenu.classList.remove("hidden");
      // Animar los items del menú con stagger
      const menuItems = mobileMenu.querySelectorAll("li");
      menuItems.forEach((item, index) => {
        const link = item.querySelector("a") as HTMLElement;
        link.style.opacity = "0";
        link.style.transform = "translateX(-30px)";
        setTimeout(() => {
          link.style.transition =
            "opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1), transform 0.4s cubic-bezier(0.16, 1, 0.3, 1)";
          link.style.opacity = "1";
          link.style.transform = "translateX(0)";
        }, index * 80);
      });
      menuIcon.innerHTML =
        '<path d="M18 6L6 18M6 6l12 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>';
    } else {
      // Animar salida
      const menuItems = mobileMenu.querySelectorAll("li");
      menuItems.forEach((item, index) => {
        const link = item.querySelector("a") as HTMLElement;
        setTimeout(() => {
          link.style.transition =
            "opacity 0.2s ease-out, transform 0.2s ease-out";
          link.style.opacity = "0";
          link.style.transform = "translateX(-30px)";
        }, index * 30);
      });
      setTimeout(() => {
        mobileMenu.classList.add("hidden");
      }, 300);
      menuIcon.innerHTML =
        '<path d="M4 6h16M4 12h16M4 18h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>';
    }
  };

  button.addEventListener("click", () => {
    toggleMobileMenu();
  });

  window.addEventListener("scroll", () => {
    if (mobileMenu && !mobileMenu.classList.contains("hidden")) {
      toggleMobileMenu();
    }
    if (menuOpen && !menuOpen.classList.contains("hidden")) {
      menuOpen.classList.add("hidden");
    }
  });
</script>
