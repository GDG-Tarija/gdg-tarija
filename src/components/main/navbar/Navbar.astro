---
import MenuList from '../navbar/menuList.json';
import Button from '../../common/Button.astro';

const JOIN_URL = 'https://gdg.community.dev/gdg-tarija/';
---

<header class="fixed inset-x-0 top-3 z-50 flex w-full justify-center px-4 md:top-5">
  <nav
    id="site-nav"
    class="relative flex w-full max-w-6xl items-center justify-between rounded-xl border border-gray-200 bg-white/85 px-4 py-2 shadow-xs backdrop-blur-lg transition-[background-color,box-shadow] duration-300 data-[scrolled=true]:bg-white/95 data-[scrolled=true]:shadow-md md:px-8"
    aria-label="Principal"
  >
    <a href="/" aria-label="GDG Tarija, inicio" class="flex h-12 items-center">
      <img
        class="h-10 w-auto md:hidden"
        src="https://res.cloudinary.com/dopkch3x9/image/upload/v1769174223/logoGDG_Tarija_nox4y2.svg"
        alt=""
      />
      <img
        class="hidden h-10 w-auto md:block"
        src="https://res.cloudinary.com/dopkch3x9/image/upload/v1752286109/gdg_tarija_logo_t3xzpo.svg"
        alt=""
      />
    </a>

    <!-- Menú de escritorio -->
    <div class="hidden items-center gap-8 md:flex lg:gap-10">
      <ul class="flex items-center gap-6 text-sm font-medium text-gray-700 lg:gap-8 lg:text-base">
        {
          MenuList.map((menu) => (
            <li>
              <a
                href={menu.href}
                data-spy-link={menu.href.replace('/#', '')}
                class="relative py-2 transition-colors duration-200 after:absolute after:-bottom-0.5 after:left-1/2 after:size-1 after:-translate-x-1/2 after:scale-0 after:rounded-full after:bg-gdg-blue after:transition-transform after:duration-300 hover:text-gray-900 aria-[current=true]:text-gray-900 aria-[current=true]:after:scale-100"
              >
                {menu.title}
              </a>
            </li>
          ))
        }
      </ul>
      <Button href={JOIN_URL} target="_blank" rel="noopener noreferrer" size="sm">Únete</Button>
    </div>

    <button
      id="menu-button"
      type="button"
      class="flex size-11 cursor-pointer items-center justify-center rounded-lg text-xl text-gray-700 transition-colors duration-200 hover:bg-gray-100 focus-visible:outline-2 focus-visible:outline-gdg-blue md:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Abrir menú"
    >
      <i class="fa-solid fa-bars" aria-hidden="true"></i>
    </button>

    <!-- Menú móvil -->
    <div
      id="mobile-menu"
      class="absolute top-full left-0 mt-2 hidden w-full overflow-hidden rounded-xl border border-gray-200 bg-white shadow-xl md:hidden"
    >
      <ul class="flex flex-col px-6 py-2">
        {
          MenuList.map((menu) => (
            <li class="border-b border-gray-100">
              <a
                href={menu.href}
                class="block py-4 text-lg font-semibold text-gray-900 transition-colors duration-200 hover:text-gdg-blue-deep"
              >
                {menu.title}
              </a>
            </li>
          ))
        }
        <li class="py-4">
          <Button
            href={JOIN_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full"
            iconPosition="right"
          >
            Únete a la comunidad
            <i slot="icon" class="fa-solid fa-arrow-right text-base" aria-hidden="true"></i>
          </Button>
        </li>
      </ul>
    </div>
  </nav>
</header>

<script>
  const button = document.getElementById('menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  const icon = button?.querySelector('i');

  const setMenuOpen = (open: boolean) => {
    if (!button || !mobileMenu) return;
    mobileMenu.classList.toggle('hidden', !open);
    button.setAttribute('aria-expanded', String(open));
    button.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    icon?.classList.toggle('fa-bars', !open);
    icon?.classList.toggle('fa-xmark', open);
  };

  button?.addEventListener('click', () => {
    setMenuOpen(button.getAttribute('aria-expanded') !== 'true');
  });

  // Al elegir una sección o hacer scroll, el menú se cierra para no tapar el contenido
  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setMenuOpen(false));
  });
  window.addEventListener('scroll', () => setMenuOpen(false), { passive: true });

  // Con scroll la barra gana opacidad y sombra: se separa del contenido que pasa por debajo
  const nav = document.getElementById('site-nav');
  const updateScrolled = () => nav?.setAttribute('data-scrolled', String(window.scrollY > 12));
  updateScrolled();
  window.addEventListener('scroll', updateScrolled, { passive: true });

  // Scrollspy: el enlace de la sección visible queda marcado con un punto azul
  const spyLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-spy-link]'));
  const sections = spyLinks
    .map((link) => document.getElementById(link.dataset.spyLink ?? ''))
    .filter((section): section is HTMLElement => section !== null);
  const markActive = (id: string | null) =>
    spyLinks.forEach((link) =>
      link.setAttribute('aria-current', String(link.dataset.spyLink === id)),
    );

  if (sections.length) {
    const spy = new IntersectionObserver(
      (entries) => {
        const visible = entries.filter((entry) => entry.isIntersecting);
        if (visible.length) markActive(visible[0].target.id);
        else if (window.scrollY < sections[0].offsetTop - window.innerHeight / 2) markActive(null);
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    sections.forEach((section) => spy.observe(section));
  }
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') setMenuOpen(false);
  });
</script>
