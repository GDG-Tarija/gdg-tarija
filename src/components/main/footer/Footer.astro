---
import redesSociales from './social-networks.json';
import SocialNetworks from './SocialNetworks.astro';

interface Props {
  logo?: string;
}

const {
  logo = 'https://res.cloudinary.com/dopkch3x9/image/upload/v1752286109/gdg_tarija_logo_t3xzpo.svg',
} = Astro.props;

// Guiño de developer al cierre del sitio, escrito como un commit
const COMMIT_LINE = 'git commit -m "hecho en Tarija, por developers de Tarija"';

const footerLinks = [
  { label: 'Eventos', href: 'https://eventos.gdgtarija.com', external: true },
  { label: 'Código de conducta', href: '/code-of-conduct', external: false },
  { label: 'Enlaces', href: '/links', external: false },
];
---

<footer class="border-t border-gray-200 bg-white">
  <div class="mx-auto max-w-6xl px-4 py-8 md:px-8">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
      <a href="/" aria-label="GDG Tarija, inicio" class="w-fit">
        <img class="h-9 w-auto" src={logo} alt="" width="160" height="36" />
      </a>
      <nav aria-label="Pie de página">
        <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm font-medium text-gray-600">
          {
            footerLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  target={link.external ? '_blank' : undefined}
                  rel={link.external ? 'noopener noreferrer' : undefined}
                  class="-my-2.5 inline-block py-2.5 transition-colors duration-200 hover:text-gray-900"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <div class="-ml-2.5 flex items-center gap-1 lg:ml-0">
        {redesSociales.map((red_social) => <SocialNetworks {...red_social} />)}
      </div>
    </div>
    <p
      class="mt-6 flex items-center justify-center gap-2 border-t border-gray-100 pt-5 font-mono text-xs text-gray-500"
      data-terminal
    >
      <span class="text-gdg-green" aria-hidden="true">$</span>
      <span data-terminal-text>{COMMIT_LINE}</span>
      <span class="terminal-caret inline-block h-3.5 w-1.5 bg-gdg-blue" aria-hidden="true"></span>
    </p>
  </div>
</footer>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .terminal-caret {
      animation: caret-blink 1.1s steps(1) infinite;
    }
  }

  @keyframes caret-blink {
    50% {
      opacity: 0;
    }
  }
</style>

<script>
  import { inView } from 'motion';

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // El texto completo ya está en el HTML (sin JS se lee igual); aquí solo se re-escribe tecla a tecla
  document.querySelectorAll<HTMLElement>('[data-terminal]').forEach((line) => {
    const target = line.querySelector<HTMLElement>('[data-terminal-text]');
    const full = target?.textContent ?? '';
    if (!target || reduceMotion) return;

    target.textContent = '';
    const stop = inView(
      line,
      () => {
        stop();
        let index = 0;
        const type = () => {
          target.textContent = full.slice(0, ++index);
          if (index < full.length) window.setTimeout(type, 38 + Math.random() * 45);
        };
        window.setTimeout(type, 250);
      },
      { amount: 1 },
    );
  });
</script>
