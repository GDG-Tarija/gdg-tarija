---
import redesSociales from "./redesSociales.json";
import RedesSociales from "./RedesSociales.astro";

interface Props {
  darkMode?: boolean;
  logo?: string;
}

const {
  darkMode = false,
  logo = "https://res.cloudinary.com/dopkch3x9/image/upload/v1752286109/gdg_tarija_logo_t3xzpo.svg",
} = Astro.props;
---

<footer
  class={`${
    darkMode
      ? "bg-linear-to-b from-black to-gray-900 border-t border-black"
      : "bg-linear-to-r from-gray-50 to-gray-100 border-t border-gray-200"
  }`}
>
  <div class="container mx-auto px-4 py-4">
    <div
      class="flex flex-col items-center space-y-3 lg:flex-row lg:justify-between lg:items-center lg:space-y-0"
    >
      <!-- Logo -->
      <div class="flex items-center">
        <img class="h-8 w-auto" src={logo} alt="GDG Tarija Logo" />
      </div>

      <!-- Redes sociales -->
      <div class="flex items-center space-x-2">
        {redesSociales.map((red_social) => <RedesSociales {...red_social} />)}
      </div>
    </div>

    <!-- Copyright -->
    <div
      class={`mt-4 pt-3 ${
        darkMode ? "border-t border-gray-700" : "border-t border-gray-200"
      }`}
    >
      <p
        class={`text-center text-xs ${
          darkMode ? "text-gray-400" : "text-gray-500"
        }`}
      >
        © {new Date().getFullYear()} GDG Tarija. Todos los derechos reservados.
      </p>
    </div>
  </div>
</footer>
