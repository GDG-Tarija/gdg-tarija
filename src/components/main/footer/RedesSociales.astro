---
import { Facebook, Instagram, Linkedin, Youtube } from "lucide-astro";
const { red_social, url, logo } = Astro.props;

const iconos = {
  facebook: Facebook,
  instagram: Instagram,
  linkedin: Linkedin,
  youtube: Youtube,
};

const IconComponent = iconos[logo];
---

<a
  href={url}
  class="p-2 rounded-full bg-gray-100 text-gray-600 transition-opacity duration-200 hover:opacity-70"
  aria-label={red_social}
>
  <IconComponent size={20} />
</a>
