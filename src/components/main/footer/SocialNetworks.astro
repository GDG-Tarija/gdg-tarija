---
interface Props {
  red_social: string;
  url: string;
  logo: string;
}

const { red_social, url, logo } = Astro.props;

const icons: Record<string, string> = {
  facebook: 'fa-brands fa-facebook',
  instagram: 'fa-brands fa-instagram',
  linkedin: 'fa-brands fa-linkedin',
  youtube: 'fa-brands fa-youtube',
  tiktok: 'fa-brands fa-tiktok',
  github: 'fa-brands fa-github',
  twitter: 'fa-brands fa-x-twitter',
  globe: 'fa-solid fa-globe',
};

const iconClass = icons[logo] ?? 'fa-solid fa-link';
const label = red_social.charAt(0).toUpperCase() + red_social.slice(1);
---

<a
  href={url}
  target="_blank"
  rel="noopener noreferrer"
  class="flex size-10 items-center justify-center rounded-lg text-gray-500 transition-colors duration-200 hover:bg-gray-100 hover:text-gray-900 focus-visible:outline-2 focus-visible:outline-gdg-blue"
  aria-label={`GDG Tarija en ${label}`}
>
  <i class={`${iconClass} text-lg`} aria-hidden="true"></i>
</a>
