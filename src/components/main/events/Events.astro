---
import Section from '../../common/Section.astro';
import SectionHeading from '../../common/SectionHeading.astro';
import ArrowLink from '../../common/ArrowLink.astro';
import Button from '../../common/Button.astro';
import rawEvents from '../../../../public/events.json';
import { formatShortDate, parseSpanishDate, toIsoDate } from '../../../utils/dates';

const EVENTS_URL = 'https://eventos.gdgtarija.com';
// Se muestran dos filas completas en escritorio; el resto queda detrás de "Ver todos"
const INITIAL_VISIBLE = 8;

// Se renderiza en el build (antes era un fetch en el cliente) para que el contenido exista sin JavaScript
const events = rawEvents
  .map((event) => ({ ...event, parsedDate: parseSpanishDate(event.date) }))
  .sort((a, b) => (b.parsedDate?.getTime() ?? 0) - (a.parsedDate?.getTime() ?? 0));

// Color del punto según el formato principal del evento (la primera palabra de "Conferencia/Taller")
const typeDot = (type: string) => {
  const main = type.split('/')[0].toLowerCase();
  if (main.startsWith('taller')) return 'bg-gdg-green';
  if (main.startsWith('hack')) return 'bg-gdg-yellow';
  return 'bg-gdg-blue';
};
---

<Section id="events" tone="base" labelledby="events-title">
  <SectionHeading id="events-title" title="Eventos pasados">
    <ArrowLink slot="action" href={EVENTS_URL} external>Ver próximos eventos</ArrowLink>
  </SectionHeading>

  <ul class="grid grid-cols-2 gap-3 md:gap-5 lg:grid-cols-4" data-reveal-group>
    {
      events.map((event, index) => (
        <li
          class:list={['flex', { hidden: index >= INITIAL_VISIBLE }]}
          data-extra-event={index >= INITIAL_VISIBLE}
        >
          <a
            href={event.link}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex w-full flex-col items-center rounded-lg border border-gray-200 bg-white p-4 text-center transition-[border-color,box-shadow] duration-150 hover:border-gray-300 hover:shadow-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gdg-blue md:p-5"
          >
            {/* Las portadas se diseñaron para verse en círculo; recortarlas en cuadrado rompe su composición */}
            <div class="size-24 overflow-hidden rounded-full bg-gray-100 ring-1 ring-gray-200 sm:size-28 md:size-32">
              <img
                src={event.src}
                alt=""
                width="500"
                height="500"
                loading="lazy"
                decoding="async"
                class="size-full object-cover transition-transform duration-300 ease-out group-hover:scale-[1.03]"
              />
            </div>
            {/* El punto va en la misma línea del texto: si la etiqueta se parte en dos, no queda suelto */}
            <span class="mt-4 max-w-full text-xs font-medium text-balance text-gray-600">
              <span
                class={`mr-1.5 inline-block size-1.5 rounded-full align-middle ${typeDot(event.title)}`}
                aria-hidden="true"
              />
              {event.title.split('/').join(' / ')}
            </span>
            <h3 class="mt-2 text-sm leading-snug font-medium text-balance text-gray-900 transition-colors duration-150 group-hover:text-gdg-blue-deep md:text-base">
              {event.fullName}
            </h3>
            <p class="mt-auto flex items-center gap-1.5 pt-3 text-xs text-gray-500 md:text-sm">
              <i class="fa-regular fa-calendar text-xs" aria-hidden="true" />
              {event.parsedDate ? (
                <time datetime={toIsoDate(event.parsedDate)}>
                  {formatShortDate(event.parsedDate)}
                </time>
              ) : (
                <span>{event.date.trim()}</span>
              )}
            </p>
          </a>
        </li>
      ))
    }
  </ul>

  {
    events.length > INITIAL_VISIBLE && (
      <div class="mt-10 flex justify-center">
        <Button id="show-all-events" variant="outline">
          Ver todos los eventos ({events.length})
        </Button>
      </div>
    )
  }
</Section>

<script>
  import { revealItems } from '../../../scripts/reveal';

  const showAllButton = document.getElementById('show-all-events');

  showAllButton?.addEventListener('click', () => {
    const extra = Array.from(document.querySelectorAll<HTMLElement>('[data-extra-event="true"]'));
    extra.forEach((item) => item.classList.remove('hidden'));
    showAllButton.parentElement?.remove();
    revealItems(extra);
  });
</script>
