---
import { Image } from 'astro:assets';
import ImgBeacons from '../../../assets/images/beacons.svg';

interface Props {
  name: string;
  Linkedin?: string;
  Github?: string;
  Facebook?: string;
  Instagram?: string;
  Sitio_web?: string;
  Beacons?: string;
}

const { name, Linkedin, Github, Facebook, Instagram, Sitio_web, Beacons } = Astro.props;

// Algunos perfiles se cargaron sin protocolo ("www.linkedin.com/..."); sin esto el enlace sería relativo al sitio
const withProtocol = (url: string) => (/^https?:\/\//.test(url) ? url : `https://${url}`);

const links = [
  { label: 'LinkedIn', url: Linkedin, icon: 'fa-brands fa-linkedin' },
  { label: 'GitHub', url: Github, icon: 'fa-brands fa-github' },
  { label: 'Sitio web', url: Sitio_web, icon: 'fa-solid fa-globe' },
  { label: 'Instagram', url: Instagram, icon: 'fa-brands fa-instagram' },
  { label: 'Facebook', url: Facebook, icon: 'fa-brands fa-facebook' },
  { label: 'Beacons', url: Beacons, icon: null },
].filter((link): link is typeof link & { url: string } => Boolean(link.url?.trim()));
---

{
  links.length > 0 && (
    <ul class="mt-4 flex flex-wrap gap-1">
      {links.map((link) => (
        <li>
          <a
            href={withProtocol(link.url)}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${link.label} de ${name}`}
            class="flex size-9 items-center justify-center rounded-lg text-gray-500 transition-colors duration-200 hover:bg-gray-100 hover:text-gray-900 focus-visible:outline-2 focus-visible:outline-gdg-blue"
          >
            {link.icon ? (
              <i class={`${link.icon} text-base`} aria-hidden="true" />
            ) : (
              <Image src={ImgBeacons} alt="" class="size-4 object-contain opacity-60" />
            )}
          </a>
        </li>
      ))}
    </ul>
  )
}
