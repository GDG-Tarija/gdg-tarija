---
import { Linkedin, Github, Facebook, Instagram, Globe } from "lucide-astro";

interface Props {
  Linkedin?: string;
  Github?: string;
  Facebook?: string;
  Instagram?: string;
  Sitio_web?: string;
}

const {
  Linkedin: linkedinUrl,
  Github: githubUrl,
  Facebook: facebookUrl,
  Instagram: instagramUrl,
  Sitio_web,
} = Astro.props;

const isValid = (url?: string): url is string =>
  typeof url === "string" && url.trim() !== "";
---

<div class="flex flex-wrap justify-center gap-2 mt-1">
  {
    isValid(linkedinUrl) && (
      <a
        href={linkedinUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="p-1 rounded-lg bg-white/20 text-white hover:bg-blue-600 hover:scale-110 transition-all duration-300 hover:shadow-lg backdrop-blur-sm"
        aria-label="LinkedIn"
      >
        <Linkedin class="h-4 w-4" />
      </a>
    )
  }
  {
    isValid(githubUrl) && (
      <a
        href={githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="p-1 rounded-lg bg-white/20 text-white hover:bg-gray-800 hover:scale-110 transition-all duration-300 hover:shadow-lg backdrop-blur-sm"
        aria-label="GitHub"
      >
        <Github class="h-4 w-4" />
      </a>
    )
  }
  {
    isValid(instagramUrl) && (
      <a
        href={instagramUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="p-1 rounded-lg bg-white/20 text-white hover:bg-pink-600 hover:scale-110 transition-all duration-300 hover:shadow-lg backdrop-blur-sm"
        aria-label="Instagram"
      >
        <Instagram class="h-4 w-4" />
      </a>
    )
  }
  {
    isValid(facebookUrl) && (
      <a
        href={facebookUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="p-1 rounded-lg bg-white/20 text-white hover:bg-blue-700 hover:scale-110 transition-all duration-300 hover:shadow-lg backdrop-blur-sm"
        aria-label="Facebook"
      >
        <Facebook class="h-4 w-4" />
      </a>
    )
  }
  {
    isValid(Sitio_web) && (
      <a
        href={Sitio_web}
        target="_blank"
        rel="noopener noreferrer"
        class="p-1 rounded-lg bg-white/20 text-white hover:bg-green-600 hover:scale-110 transition-all duration-300 hover:shadow-lg backdrop-blur-sm"
        aria-label="Sitio web"
      >
        <Globe class="h-4 w-4" />
      </a>
    )
  }
</div>
