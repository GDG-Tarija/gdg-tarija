---
const {
  Linkedin: linkedinUrl,
  Github: githubUrl,
  Facebook: facebookUrl,
  Instagram: instagramUrl,
  Sitio_web,
} = Astro.props;
---

<div class="flex flex-wrap gap-3 mt-4 justify-center mb-4">
  {
    linkedinUrl && linkedinUrl !== "" && (
      <a
        href={linkedinUrl}
        class="text-xl flex p-3 rounded bg-white/20 text-white hover:bg-blue-600 hover:scale-110 transition-all duration-300 hover:shadow-lg backdrop-blur-xs "
        aria-label="LinkedIn"
      >
          <i class="fa-brands fa-linkedin"></i>
      </a>
    )
  }
  {
    Sitio_web && Sitio_web !== "" && (
      <a
        href={Sitio_web}
        class="text-xl flex p-3 rounded bg-white/20 text-white hover:bg-green-600 hover:scale-110 transition-all duration-300 hover:shadow-lg backdrop-blur-xs"
        aria-label="Sitio Web"
      >
         <i class="fa-solid fa-globe"></i>
      </a>
    )
  }
  {
    githubUrl && githubUrl !== "" && (
      <a
        href={githubUrl}
        class="text-xl flex p-3 rounded bg-white/20 text-white hover:bg-gray-800 hover:scale-110 transition-all duration-300 hover:shadow-lg backdrop-blur-xs"
        aria-label="GitHub"
      >
          <i class="fa-brands fa-github"></i>
      </a>
    )
  }
  {
    instagramUrl && instagramUrl !== "" && (
      <a
        href={instagramUrl}
        class="text-xl flex p-3 rounded bg-white/20 text-white hover:bg-linear-to-r hover:from-purple-500 hover:to-pink-500 hover:scale-110 transition-all duration-300 hover:shadow-xl backdrop-blur-xs"
        aria-label="Instagram"
      >
          <i class="fa-brands fa-instagram"></i>
      </a>
    )
  }
  {
      facebookUrl && facebookUrl !== "" && (
      <a
        href={facebookUrl}
        class="text-xl flex p-3 rounded bg-white/20 text-white hover:bg-blue-700 hover:scale-110 transition-all duration-300 hover:shadow-lg backdrop-blur-xs"
        aria-label="Facebook"
      >
          <i class="fa-brands fa-facebook"></i>
      </a>
    )
  }
</div>
