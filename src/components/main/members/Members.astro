---
import Section from '../../common/Section.astro';
import SectionHeading from '../../common/SectionHeading.astro';
import members from './members.json';
import MemberCard from './MemberCard.astro';
import Button from '../../common/Button.astro';
import { commissionColor } from './commissions';

const ALL = 'Todos';
// Con 35 personas la lista se vuelve muy larga en celular; se muestran dos filas de escritorio y el resto a pedido
const INITIAL_VISIBLE = 8;

// Organizers primero; el resto por comisión principal y nombre, para que el orden sea estable al agregar gente
const sortedMembers = [...members].sort((a, b) => {
  const aIsOrg = a.Commission[0] === 'Organizer';
  const bIsOrg = b.Commission[0] === 'Organizer';

  if (aIsOrg && !bIsOrg) return -1;
  if (!aIsOrg && bIsOrg) return 1;

  const cmpComision = a.Commission[0].localeCompare(b.Commission[0], 'es');
  if (cmpComision !== 0) return cmpComision;
  return a.Name.localeCompare(b.Name, 'es');
});

const comisiones = [ALL, ...new Set(sortedMembers.flatMap((m) => m.Commission))];
const countFor = (c: string) =>
  c === ALL ? sortedMembers.length : sortedMembers.filter((m) => m.Commission.includes(c)).length;
---

<Section id="members" tone="surface" labelledby="members-title">
  <SectionHeading id="members-title" title="Equipo" lead="Las personas que organizan GDG Tarija." />

  <div
    class="-mx-4 mb-8 flex gap-2 overflow-x-auto px-4 pb-1 [scrollbar-width:none] sm:mx-0 sm:flex-wrap sm:overflow-visible sm:px-0 sm:pb-0"
    role="group"
    aria-label="Filtrar equipo por comisión"
  >
    {
      comisiones.map((c) => (
        <button
          type="button"
          class="filter-chip inline-flex h-9 shrink-0 cursor-pointer items-center gap-2 rounded-lg border border-gray-300 px-3 text-sm font-medium text-gray-700 transition-colors duration-200 hover:bg-gray-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gdg-blue aria-pressed:border-transparent aria-pressed:bg-gdg-ice-blue aria-pressed:text-gray-900"
          data-filter={c}
          aria-pressed={c === ALL ? 'true' : 'false'}
        >
          {c !== ALL && (
            <span
              class="size-2 rounded-full"
              style={`background: ${commissionColor(c)};`}
              aria-hidden="true"
            />
          )}
          {c}
          <span class="text-gray-500 tabular-nums">{countFor(c)}</span>
        </button>
      ))
    }
  </div>

  <ul id="members-grid" class="grid grid-cols-2 gap-3 md:grid-cols-4 md:gap-4 lg:gap-5">
    {
      sortedMembers.map((member, index) => (
        <li
          class="member-item"
          data-comision={JSON.stringify(member.Commission)}
          hidden={index >= INITIAL_VISIBLE}
        >
          <MemberCard {...member} />
        </li>
      ))
    }
  </ul>

  {
    sortedMembers.length > INITIAL_VISIBLE && (
      <div id="members-more" class="mt-10 flex justify-center">
        <Button id="show-all-members" variant="outline">
          Ver todo el equipo ({sortedMembers.length})
        </Button>
      </div>
    )
  }
</Section>

<script>
  const INITIAL_VISIBLE = 8;
  const chips = document.querySelectorAll<HTMLButtonElement>('.filter-chip');
  const items = Array.from(document.querySelectorAll<HTMLElement>('.member-item'));
  const moreContainer = document.getElementById('members-more');
  let expanded = false;
  let selected = 'Todos';

  // Un filtro por comisión siempre muestra a todos sus miembros; el recorte inicial solo aplica a "Todos"
  function render() {
    chips.forEach((chip) => {
      chip.setAttribute('aria-pressed', chip.dataset.filter === selected ? 'true' : 'false');
    });

    const showAll = selected === 'Todos';
    items.forEach((item, index) => {
      const comisiones: string[] = JSON.parse(item.dataset.comision ?? '[]');
      const matches = showAll || comisiones.includes(selected);
      const withinLimit = expanded || !showAll || index < INITIAL_VISIBLE;
      item.hidden = !(matches && withinLimit);
    });

    if (moreContainer) moreContainer.hidden = expanded || !showAll;
  }

  chips.forEach((chip) =>
    chip.addEventListener('click', () => {
      selected = chip.dataset.filter ?? 'Todos';
      render();
    }),
  );

  document.getElementById('show-all-members')?.addEventListener('click', () => {
    expanded = true;
    render();
  });
</script>
