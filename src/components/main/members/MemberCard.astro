---
import MemberSocialNetworks from './MemberSocialNetworks.astro';
import { commissionColor } from './commissions';
import { cloudinaryAvatar } from '../../../utils/cloudinary';

interface Props {
  Photo: string;
  Name: string;
  About: string;
  Commission: string[];
  Linkedin?: string;
  Github?: string;
  Facebook?: string;
  Instagram?: string;
  Sitio_web?: string;
  Beacons?: string;
}

const { Photo, Name, About, Commission, ...socials } = Astro.props;

const initials = Name.split(' ')
  .map((w) => w[0])
  .slice(0, 2)
  .join('');
const bioId = `bio-${Name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
---

<article
  class="member-card relative flex h-full flex-col items-center rounded-xl border border-gray-200 bg-white p-4 text-center transition-[border-color,box-shadow] duration-200 hover:border-gray-300 hover:shadow-md lg:p-6"
>
  <div class="relative size-24 shrink-0 sm:size-28 lg:size-32">
    <!-- Iniciales de respaldo si la foto de Cloudinary no carga -->
    <span
      class="absolute inset-0 flex items-center justify-center rounded-full bg-gray-100 text-xl font-semibold text-gray-500"
      aria-hidden="true"
    >
      {initials}
    </span>
    <img
      src={cloudinaryAvatar(Photo, 256)}
      alt={`Foto de ${Name}`}
      width="128"
      height="128"
      loading="lazy"
      decoding="async"
      class="relative size-full rounded-full object-cover"
      onerror="this.remove()"
    />
  </div>
  <h3 class="mt-4 leading-snug font-semibold text-balance text-gray-900 md:text-lg">{Name}</h3>
  <ul class="mt-2 flex flex-wrap justify-center gap-1.5" aria-label="Comisiones">
    {
      Commission.map((c) => (
        <li class="inline-flex items-center gap-1.5 rounded-md bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-700">
          <span
            class="size-1.5 rounded-full"
            style={`background: ${commissionColor(c)};`}
            aria-hidden="true"
          />
          {c}
        </li>
      ))
    }
  </ul>
  <button
    type="button"
    class="member-open mt-auto inline-flex cursor-pointer items-center gap-1.5 whitespace-nowrap rounded-full px-3 pt-5 pb-1 text-sm font-semibold text-gdg-blue transition-colors duration-200 hover:text-gdg-blue-deep focus-visible:outline-2 focus-visible:outline-gdg-blue"
    aria-expanded="false"
    aria-controls={bioId}
  >
    Ver perfil
    <i class="fa-solid fa-plus text-xs" aria-hidden="true"></i>
  </button>

  <!-- La bio se superpone dentro de la misma card para no mover la grilla al abrirla -->
  <div
    id={bioId}
    class="member-bio absolute inset-0 flex flex-col rounded-xl bg-white p-4 text-left lg:p-6"
    hidden
  >
    <div class="flex items-start justify-between gap-3">
      <p class="leading-snug font-semibold text-gray-900">{Name}</p>
      <button
        type="button"
        class="member-close -mt-1 -mr-1 flex size-8 shrink-0 cursor-pointer items-center justify-center rounded-full text-gray-500 transition-colors duration-200 hover:bg-gray-100 hover:text-gray-900 focus-visible:outline-2 focus-visible:outline-gdg-blue"
        aria-label={`Cerrar perfil de ${Name}`}
      >
        <i class="fa-solid fa-xmark" aria-hidden="true"></i>
      </button>
    </div>
    <p
      class="member-bio-text mt-3 flex-1 overflow-y-auto pr-1 text-sm leading-relaxed text-pretty text-gray-600"
    >
      {About}
    </p>
    <MemberSocialNetworks name={Name} {...socials} />
  </div>
</article>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .member-bio:not([hidden]) {
      animation: bio-in 0.25s ease-out both;
    }
  }

  @keyframes bio-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .member-bio-text {
    scrollbar-width: thin;
    scrollbar-color: var(--color-gray-300) transparent;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.member-card').forEach((card) => {
    const openButton = card.querySelector<HTMLButtonElement>('.member-open');
    const closeButton = card.querySelector<HTMLButtonElement>('.member-close');
    const bio = card.querySelector<HTMLElement>('.member-bio');
    if (!openButton || !closeButton || !bio) return;

    const setOpen = (open: boolean) => {
      bio.hidden = !open;
      openButton.setAttribute('aria-expanded', String(open));
      // El foco sigue al contenido para que el teclado no quede atrapado detrás de la capa
      (open ? closeButton : openButton).focus();
    };

    openButton.addEventListener('click', () => setOpen(true));
    closeButton.addEventListener('click', () => setOpen(false));
    bio.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setOpen(false);
    });
  });
</script>
