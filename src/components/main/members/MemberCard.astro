---
import { Image } from 'astro:assets';
import RedesSocialesMember from './RedesSocialesMember.astro';
import tailwindConfig from '../../../../tailwind.config.js';

interface Props {
	Photo: string;
	Name: string;
	About: string;
	Commission: string[];
	Linkedin?: string;
	Github?: string;
	Facebook?: string;
	Instagram?: string;
	Sitio_web?: string;
}

const { Photo, Name, About, Linkedin, Github, Facebook, Instagram, Sitio_web, Commission } = Astro.props;
const customColors = tailwindConfig.theme.extend.colors as Record<string, string>;
const BADGE_COLORS: Record<string, { bg: string; text: string }> = {
	Organizer: { bg: '#162440', text: customColors['halftone-blue'] },
	Decoración: { bg: '#57220d', text: customColors['pastel-red'] },
	Desarrollo: { bg: '#042424', text: customColors['pastel-green'] },
	Diseño: { bg: '#2a0e0e', text: customColors['halftone-red'] },
	Logística: { bg: '#072012', text: customColors['halftone-green'] },
	Marketing: { bg: '#2a2000', text: customColors['halftone-yellow'] },
	Staff: { bg: '#003462', text: customColors['pastel-blue'] },
	Transmisión: { bg: '#220d40', text: customColors['halftone-red'] },
};

const frontBadges = Commission.slice(0, 2);
const backBadges = Commission;
const primaryBadge = BADGE_COLORS[Commission[0]] ?? BADGE_COLORS['Organizer'];

const initials = Name.split(' ')
	.map((w) => w[0])
	.slice(0, 2)
	.join('');
---

<div
	class='member-card relative h-[280px] w-[230px] justify-self-center shadow-lg shadow-slate-900 cursor-pointer [perspective:900px] transition-all duration-300 hover:scale-105 hover:shadow-xl'
	aria-label={`Perfil de ${Name}`}>
	<div
		class='flip-inner absolute inset-0 rounded-2xl
			[transform-style:preserve-3d]
			transition-transform duration-[450ms] ease-[cubic-bezier(0.4,0,0.2,1)]'>
		<!-- ── CARA FRONTAL ── -->
		<div
			class='card-wrapper !absolute inset-0
            [backface-visibility:hidden] [-webkit-backface-visibility:hidden]
            shadow-lg shadow-slate-900'>
			<div class='card-content flex flex-col items-center justify-center justify-items-center gap-2 p-4 text-center'>
				<!-- Avatar de iniciales: se muestra si la imagen falla -->
				<div
					class='hidden w-32 h-32 rounded-full items-center justify-center
						text-xl font-semibold flex-shrink-0 bg-slate-700 text-zinc-300'
					aria-hidden='true'>
					{initials}
				</div>
				<Image
					src={Photo}
					width='50'
					height='50'
					alt={`Foto de ${Name}`}
					class='rounded-full w-32 h-32 object-cover border-2 border-neutral-700'
					loading='lazy'
					onerror="this.style.display='none'; this.previousElementSibling.classList.replace('hidden','flex');"
				/>
				<p class='font-semibold text-zinc-100 leading-snug mb-2'>{Name}</p>
				<div class='flex flex-wrap gap-1 justify-center'>
					{
						frontBadges.map((c) => {
							const colors = BADGE_COLORS[c] ?? BADGE_COLORS['Organizer'];
							return (
								<span
									class='text-xs font-medium px-2.5 py-0.5 rounded-full whitespace-nowrap'
									style={`background: ${colors.bg}; color: ${colors.text};`}>
									{c}
								</span>
							);
						})
					}
				</div>
				<span class='flex items-center gap-1 text-[10px] text-zinc-300 mt-0.5'>
					<svg
						width='11'
						height='11'
						viewBox='0 0 24 24'
						fill='none'
						stroke='currentColor'
						stroke-width='2.5'
						aria-hidden='true'>
						<path d='M4 6h16M4 12h16M4 18h8'></path>
					</svg>
					Ver perfil
				</span>
			</div>
		</div>
		<!-- ── CARA TRASERA ── -->
		<div
			class='face-back absolute inset-0 rounded-2xl
            bg-gradient-to-b from-gray-600 to-gray-700
            border border-zinc-600
            [backface-visibility:hidden] [-webkit-backface-visibility:hidden]
            [transform:rotateY(180deg)]
            flex flex-col gap-2 p-6 overflow-hidden'>
			<div class='flex justify-between items-start flex-shrink-0 gap-2'>
				<div class='min-w-0'>
					<p class='text-sm font-semibold m-0 mb-2 truncate' style={`color: ${primaryBadge.text};`}>
						{Name}
					</p>
					<!-- Todos los badges en el reverso -->
					<div class='flex flex-wrap gap-1'>
						{
							backBadges.map((c) => {
								const colors = BADGE_COLORS[c] ?? BADGE_COLORS['Organizer'];
								return (
									<span
										class='text-[10px] font-medium px-2 py-0.5 rounded-full whitespace-nowrap'
										style={`background: ${colors.bg}; color: ${colors.text};`}>
										{c}
									</span>
								);
							})
						}
					</div>
				</div>
				<button
					class='close-btn flex-shrink-0 flex items-center justify-center w-6 h-6
                rounded-full bg-zinc-700 hover:bg-zinc-600 text-zinc-400 text-[11px]
                leading-none border-none cursor-pointer transition-colors duration-150'
					aria-label='Cerrar perfil'>
					<svg
						xmlns='http://www.w3.org/2000/svg'
						enable-background='new 0 0 24 24'
						height='16'
						viewBox='0 0 24 24'
						width='16'
						><g><rect fill='none' height='24' width='24'></rect></g><g
							><g
								><path d='M9,12c0,1.66,1.34,3,3,3s3-1.34,3-3s-1.34-3-3-3S9,10.34,9,12z' fill='#9f9fa9'></path><path
									d='M8,10V8H5.09C6.47,5.61,9.05,4,12,4c3.72,0,6.85,2.56,7.74,6h2.06c-0.93-4.56-4.96-8-9.8-8C8.73,2,5.82,3.58,4,6.01V4H2v6 H8z'
									fill='#9f9fa9'></path><path
									d='M16,14v2h2.91c-1.38,2.39-3.96,4-6.91,4c-3.72,0-6.85-2.56-7.74-6H2.2c0.93,4.56,4.96,8,9.8,8c3.27,0,6.18-1.58,8-4.01V20 h2v-6H16z'
									fill='#9f9fa9'></path></g
							></g
						></svg
					>
				</button>
			</div>
			<p class='about-text flex-1 text-xs text-zinc-400 leading-relaxed overflow-y-auto m-0 pr-0.5'>
				{About}
			</p>
			<div class='flex-shrink-0 mt-auto'>
				<RedesSocialesMember
					Linkedin={Linkedin}
					Github={Github}
					Facebook={Facebook}
					Instagram={Instagram}
					Sitio_web={Sitio_web}
				/>
			</div>
		</div>
	</div>
</div>
<style>
	.member-card.is-flipped .flip-inner {
		transform: rotateY(180deg);
	}
	.about-text {
		scrollbar-width: thin;
		scrollbar-color: #52525b transparent;
	}
	.about-text::-webkit-scrollbar {
		width: 3px;
	}
	.about-text::-webkit-scrollbar-thumb {
		background: #52525b;
		border-radius: 2px;
	}
</style>
<script>
	document.querySelectorAll<HTMLElement>('.member-card').forEach((card) => {
		card.addEventListener('click', (e) => {
			const target = e.target as HTMLElement;

			if (target.closest('.close-btn')) {
				card.classList.remove('is-flipped');
				return;
			}

			if (target.closest('a')) return;

			card.classList.toggle('is-flipped');
		});
	});
</script>
