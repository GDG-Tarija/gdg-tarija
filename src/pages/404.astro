---
import Layout from '../layouts/Layout.astro';
import Navbar from 'components/main/navbar/Navbar.astro';
import Footer from 'components/main/footer/Footer.astro';
import Button from 'components/common/Button.astro';
---

<Layout title="404 - Página no encontrada">
  <Fragment slot="head">
    <script
      src="https://unpkg.com/@lottiefiles/dotlottie-wc@0.8.11/dist/dotlottie-wc.js"
      type="module"></script>
  </Fragment>
  <Navbar />
  <main class="min-h-screen flex items-center justify-center px-4 py-20 md:py-24">
    <div class="text-center max-w-2xl mx-auto">
      <!-- Contenedor para animación Lottie -->
      <div
        class="w-full max-w-md mx-auto mb-8 flex items-center justify-center overflow-hidden"
        style="aspect-ratio: 1; max-width: 450px;"
      >
        <dotlottie-wc
          src="https://lottie.host/56967063-316a-40cf-a28b-a362e995ee25/PbZAhFr8HM.lottie"
          style="width: 100%; height: 100%; object-fit: cover; transform: scale(1);"
          autoplay
          loop></dotlottie-wc>
      </div>

      <!-- Mensaje -->
      <h1 class="text-4xl md:text-5xl font-bold mb-4 text-gray-800">Página no encontrada</h1>
      <p class="text-lg text-gray-600 mb-8">
        Lo sentimos, la página que buscas no existe o ha sido movida.
      </p>

      <!-- Botón para volver -->
      <Button href="/" size="lg"> Volver al inicio </Button>
    </div>
  </main>
  <Footer />
</Layout>
