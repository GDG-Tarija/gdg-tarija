---
import Layout from 'layouts/Layout.astro';
import Hero from 'components/bwai2026/hero/Hero.astro';
import Footer from 'components/bwai2026/footer/Footer.astro';
import AuroraBackground from 'components/bwai2026/hero/AuroraBackground.astro';
import Navbar from 'components/bwai2026/Navbar.astro';
import FAQ from 'components/bwai2026/faq/FAQ.astro';
import About from 'components/bwai2026/About.astro';
import Sponsors from 'components/bwai2026/sponsors/Sponsors.astro';
import RoadToBuild from 'components/bwai2026/road/RoadToBuild.astro';
import SpeakersRoad from 'components/bwai2026/speakers-road/SpeakersRoad.astro';

const title = 'Build with AI 2026 - Tarija';
const description =
  'Únete a nosotros en Build with AI 2026 en Tarija, donde exploraremos los últimos avances en inteligencia artificial y cómo puede transformar nuestro mundo. Descubre soluciones innovadoras, establece contactos con expertos del sector y forma parte del futuro de la tecnología.';
const image = 'https://res.cloudinary.com/startup-grind/image/upload/c_fill,w_500,h_500,g_center/c_fill,dpr_2.0,f_auto,g_center,q_auto:good/v1/gcs/platform-data-goog/events/blob_bSpSUbb';
const canonical = 'https://gdgtarija.com/build-with-ai/'
---

<Layout title={title} description={description} image={image} canonical={canonical}>
  <Navbar />
  <main>
    <AuroraBackground />
    <Hero />
    <About />
    <RoadToBuild />
    <SpeakersRoad />
    <Sponsors />
    <FAQ />
  </main>
  <Footer />
</Layout>
